{
  "name": "vinifera",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "vite build && node scripts/build.mjs",
    "build:pages": "CF_PAGES=1 npm run build",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "check": "npm run typecheck && npm run test && npm run build && npm run build:worker",
    "cf-typegen": "wrangler types",
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev",
    "lint": "tsc --noEmit",
    "qa:e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "20.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "29.1.1",
    "supertest": "7.2.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
