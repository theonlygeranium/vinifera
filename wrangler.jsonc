{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vinifera",
  "main": "server/worker.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "APP_ENV": "production",
    "APP_ORIGIN": "https://vinifera.edstratumlabs.ai",
    "ALLOWED_ORIGINS": "https://vinifera.edstratumlabs.ai"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
