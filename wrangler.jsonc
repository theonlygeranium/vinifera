{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vinifera",
  "main": "server/worker.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "APP_ENV": "production",
    "APP_ORIGIN": "https://vinifera.edstratumlabs.ai",
    "ALLOWED_ORIGINS": "https://vinifera.edstratumlabs.ai,capacitor://localhost,https://localhost"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "env": {
    "production": {
      "name": "vinifera-production",
      "workers_dev": true,
      "preview_urls": true,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none",
        "run_worker_first": true
      },
      "vars": {
        "APP_ENV": "production",
        "APP_ORIGIN": "https://vinifera.edstratumlabs.ai",
        "ALLOWED_ORIGINS": "https://vinifera.edstratumlabs.ai,capacitor://localhost,https://localhost",
        "LIVE_BILLING_ENABLED": "false"
      }
    },
    "staging": {
      "name": "vinifera-staging",
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none",
        "run_worker_first": true
      },
      "vars": {
        "APP_ENV": "staging",
        "APP_ORIGIN": "https://staging.vinifera.edstratumlabs.ai",
        "ALLOWED_ORIGINS": "https://staging.vinifera.edstratumlabs.ai,capacitor://localhost,https://localhost"
      }
    }
  }
}
