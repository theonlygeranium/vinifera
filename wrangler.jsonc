{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vinifera",
  "main": "server/worker.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "APP_ENV": "production",
    "APP_ORIGIN": "https://vinifera.edstratumlabs.ai",
    "ALLOWED_ORIGINS": "https://vinifera.edstratumlabs.ai,capacitor://localhost,https://localhost"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
      "persist": true
    }
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "queues": {
    "producers": [
      {
        "binding": "INTEGRATION_WAKE_QUEUE",
        "queue": "vinifera-integration-wake-development"
      }
    ],
    "consumers": [
      {
        "queue": "vinifera-integration-wake-development",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 5,
        "retry_delay": 5
      }
    ]
  },
  "env": {
    "production": {
      "name": "vinifera-production",
      "workers_dev": true,
      "preview_urls": true,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none",
        "run_worker_first": true
      },
      "queues": {
        "producers": [
          {
            "binding": "INTEGRATION_WAKE_QUEUE",
            "queue": "vinifera-integration-wake-production"
          }
        ],
        "consumers": [
          {
            "queue": "vinifera-integration-wake-production",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "max_concurrency": 5,
            "retry_delay": 5
          }
        ]
      },
      "vars": {
        "APP_ENV": "production",
        "APP_ORIGIN": "https://vinifera.edstratumlabs.ai",
        "ALLOWED_ORIGINS": "https://vinifera.edstratumlabs.ai,capacitor://localhost,https://localhost",
        "LIVE_BILLING_ENABLED": "false"
      }
    },
    "staging": {
      "name": "vinifera-staging",
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none",
        "run_worker_first": true
      },
      "queues": {
        "producers": [
          {
            "binding": "INTEGRATION_WAKE_QUEUE",
            "queue": "vinifera-integration-wake-staging"
          }
        ],
        "consumers": [
          {
            "queue": "vinifera-integration-wake-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 3,
            "max_concurrency": 5,
            "retry_delay": 5
          }
        ]
      },
      "vars": {
        "APP_ENV": "staging",
        "APP_ORIGIN": "https://staging.vinifera.edstratumlabs.ai",
        "ALLOWED_ORIGINS": "https://staging.vinifera.edstratumlabs.ai,capacitor://localhost,https://localhost"
      }
    }
  }
}
