step "checkout-pr-branch" {
    name = "Checkout PR Branch"

    action {
        action_type = "Octopus.Script"
        notes = "Clone the PR branch into a temp directory."
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                set -e
                REPO_URL="https://#{GitHubPAT}@github.com/theonlygeranium/vinifera.git"
                BRANCH="#{PRBranch}"
                WORK_DIR="/tmp/vinifera-bot-$$"
                echo "Cloning branch: $BRANCH"
                git clone --depth=1 --branch "$BRANCH" "$REPO_URL" "$WORK_DIR"
                echo "WORK_DIR=$WORK_DIR" > /tmp/octopus_bot_workdir
                echo "Checkout complete: $WORK_DIR"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}

step "run-all-rules-capture-output" {
    name = "Run All Rules and Capture Output"

    action {
        action_type = "Octopus.Script"
        notes = "Executes all 10 architectural rules. Captures pass/fail results; non-zero exit only if a structural error occurs. Results saved to /tmp/rule_results."
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                source /tmp/octopus_bot_workdir 2>/dev/null || WORK_DIR="/tmp/vinifera-bot"
                cd "$WORK_DIR"
                RESULTS_FILE="/tmp/rule_results_$$"
                echo "RESULTS_FILE=$RESULTS_FILE" >> /tmp/octopus_bot_workdir
                FAILURES=()

                # Rule 1 — No direct route-to-database access
                R1=$(grep -rn --include="*.ts" -E "createClient\s*\(|from ["']@supabase/supabase-js["']" server/routes/ 2>/dev/null || true)
                if [ -n "$R1" ]; then FAILURES+=("**Rule 1 — No Direct Route-to-Database Access**\n\`\`\`\n$R1\n\`\`\`"); fi

                # Rule 2 — No circular imports
                V1=$(grep -rn --include="*.ts" "from.*server/routes" server/services/ 2>/dev/null || true)
                V2=$(grep -rn --include="*.ts" "from.*server/integrations" server/routes/ 2>/dev/null || true)
                [ -n "$V1" ] && FAILURES+=("**Rule 2 — Circular Import (services→routes)**\n\`\`\`\n$V1\n\`\`\`")
                [ -n "$V2" ] && FAILURES+=("**Rule 2 — Circular Import (routes→integrations)**\n\`\`\`\n$V2\n\`\`\`")

                # Rule 3 — No provider secrets
                R3=$(grep -rn --include="*.ts" -E "(sk_live_|sk_test_|rk_live_|ep_test_|re_)[A-Za-z0-9_]+" server/ src/ 2>/dev/null || true)
                [ -n "$R3" ] && FAILURES+=("**Rule 3 — Provider Secret in Source**\n\`\`\`\n$R3\n\`\`\`")

                # Rule 4 — Zod validation on all API inputs
                R4=$(grep -rn --include="*.ts" "req\.body\|req\.params" server/routes/ 2>/dev/null | grep -v "safeParse\|\.parse(" || true)
                [ -n "$R4" ] && FAILURES+=("**Rule 4 — Missing Zod Validation**\n\`\`\`\n$R4\n\`\`\`")

                # Rule 5 — HTTP-only cookie JWTs
                R5=$(grep -rn --include="*.ts" "headers\.authorization\|Authorization.*Bearer" server/ 2>/dev/null | grep -v "mobile\|native\|\.test\." || true)
                [ -n "$R5" ] && FAILURES+=("**Rule 5 — JWT from Authorization Header (use httpOnly cookie)**\n\`\`\`\n$R5\n\`\`\`")

                # Rule 6 — Fail-closed provider activation
                R6=$(grep -rn --include="*.ts" -E "(easypost|resend|stripe)\." server/services/ server/integrations/ 2>/dev/null | grep -v "isActive\|isEnabled\|activation\|\.test\." || true)
                [ -n "$R6" ] && FAILURES+=("**Rule 6 — Provider Called Without Activation Guard**\n\`\`\`\n$R6\n\`\`\`")

                # Rule 7 — Idempotency keys
                R7=$(grep -rn --include="*.ts" -E "(paymentIntents\.create|labels\.create|emails\.send)" server/ 2>/dev/null | grep -v "idempotency\|idempotencyKey" || true)
                [ -n "$R7" ] && FAILURES+=("**Rule 7 — Mutating Provider Call Without Idempotency Key**\n\`\`\`\n$R7\n\`\`\`")

                # Rule 8 — Tenant isolation
                R8=$(grep -rn --include="*.ts" "\.select(\|\.update(\|\.delete(\|\.insert(" server/services/ 2>/dev/null | grep -v "brand_id\|organization_id\|brandId\|organizationId" || true)
                [ -n "$R8" ] && FAILURES+=("**Rule 8 — Database Query Without Tenant Scoping**\n\`\`\`\n$R8\n\`\`\`")

                # Rule 9 — CHANGELOG.md updated
                CHANGELOG_DIFF=$(git diff HEAD~1 -- CHANGELOG.md 2>/dev/null || true)
                NON_DOC_DIFF=$(git diff HEAD~1 --name-only 2>/dev/null | grep -v "\.md$\|docs/" || true)
                [ -n "$NON_DOC_DIFF" ] && [ -z "$CHANGELOG_DIFF" ] && FAILURES+=("**Rule 9 — CHANGELOG.md Not Updated**\nChanged files without a CHANGELOG entry:\n\`\`\`\n$NON_DOC_DIFF\n\`\`\`")

                # Rule 10 — No `any` type in new server code
                R10=$(git diff HEAD~1 -- 'server/**/*.ts' 2>/dev/null | grep "^+" | grep -E ":\s*any\b|as any\b" | grep -v "^+++" || true)
                [ -n "$R10" ] && FAILURES+=("**Rule 10 — TypeScript \`any\` in New Server Code**\n\`\`\`\n$R10\n\`\`\`")

                # Write results
                FAILURE_COUNT=${#FAILURES[@]}
                printf '{"failure_count":%d,"failures":' "$FAILURE_COUNT" > "$RESULTS_FILE"
                printf '['
                for i in "${!FAILURES[@]}"; do
                    [ $i -gt 0 ] && printf ','
                    printf '"%s"' "${FAILURES[$i]//"/\\"}"
                done
                printf ']}' >> "$RESULTS_FILE"

                # Also write plain text for LiteLLM prompt
                PLAIN_FILE="${RESULTS_FILE}.txt"
                echo "PR Branch: #{PRBranch}" > "$PLAIN_FILE"
                echo "Failure count: $FAILURE_COUNT" >> "$PLAIN_FILE"
                for f in "${FAILURES[@]}"; do
                    echo -e "\n---\n$f" >> "$PLAIN_FILE"
                done

                echo "Captured $FAILURE_COUNT rule failures. Results at $RESULTS_FILE"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}

step "ai-analysis-via-palmyra" {
    name = "AI Analysis via Palmyra X5"

    action {
        action_type = "Octopus.Script"
        notes = "Sends rule violation output to Palmyra X5 via LiteLLM on Schubert. Generates a structured developer-facing explanation with remediation steps. Writes result to /tmp/ai_analysis."
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                source /tmp/octopus_bot_workdir 2>/dev/null || true
                PLAIN_FILE="${RESULTS_FILE}.txt"

                if [ ! -f "$PLAIN_FILE" ]; then
                    echo "No results file found — skipping AI analysis."
                    exit 0
                fi

                FAILURE_TEXT=$(cat "$PLAIN_FILE")
                FAILURE_COUNT=$(grep "^Failure count:" "$PLAIN_FILE" | awk '{print $3}')

                if [ "$FAILURE_COUNT" = "0" ]; then
                    echo "All rules passed — no AI analysis needed."
                    echo "AI_COMMENT=" > /tmp/ai_analysis_$$
                    echo "AI_ANALYSIS_FILE=/tmp/ai_analysis_$$" >> /tmp/octopus_bot_workdir
                    exit 0
                fi

                ESCAPED=$(python3 -c "
import sys, json
with open('$PLAIN_FILE') as f:
content = f.read()
prompt = '''You are a senior engineer reviewing a pull request for the Vinifera platform.
The following architectural rules were violated. For each violation:
1. Explain in plain terms what the problem is and why it matters.
2. Show the exact fix (code snippet) the developer should apply.
3. Be direct and concise. No preamble.

Violations:
''' + content
print(json.dumps(prompt))
")

                RESPONSE=$(curl -sf -X POST http://172.17.0.1:4000/v1/chat/completions \
                    -H "Authorization: Bearer #{LiteLLMKey}" \
                    -H "Content-Type: application/json" \
                    -d "{"model": "writer/palmyra-x5", "messages": [{"role": "user", "content": $ESCAPED}], "max_tokens": 2000}" 2>&1)

                AI_TEXT=$(echo "$RESPONSE" | python3 -c "
import sys, json
try:
data = json.load(sys.stdin)
print(data['choices'][0]['message']['content'])
except Exception as e:
print(f'[AI analysis unavailable: {e}]')
")

                AI_ANALYSIS_FILE="/tmp/ai_analysis_$$"
                echo "$AI_TEXT" > "$AI_ANALYSIS_FILE"
                echo "AI_ANALYSIS_FILE=$AI_ANALYSIS_FILE" >> /tmp/octopus_bot_workdir
                echo "AI analysis complete (${#AI_TEXT} chars)."
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}

step "post-github-pr-comment" {
    name = "Post GitHub PR Comment"

    action {
        action_type = "Octopus.Script"
        notes = "Posts the AI analysis and raw rule violations as a formatted comment on the GitHub PR. Uses the GitHub Issues Comments API."
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                source /tmp/octopus_bot_workdir 2>/dev/null || true
                PLAIN_FILE="${RESULTS_FILE}.txt"
                FAILURE_COUNT=$(grep "^Failure count:" "$PLAIN_FILE" 2>/dev/null | awk '{print $3}')

                if [ "$FAILURE_COUNT" = "0" ] || [ -z "$FAILURE_COUNT" ]; then
                    echo "All rules passed — no comment to post."
                    exit 0
                fi

                AI_TEXT=""
                [ -n "$AI_ANALYSIS_FILE" ] && [ -f "$AI_ANALYSIS_FILE" ] && AI_TEXT=$(cat "$AI_ANALYSIS_FILE")

                RAW_VIOLATIONS=$(grep -A 200 "^---" "$PLAIN_FILE" 2>/dev/null || echo "(see Octopus task log)")

                COMMENT_BODY=$(python3 -c "
import json

failure_count = '$FAILURE_COUNT'
ai_text = open('$AI_ANALYSIS_FILE').read() if '$AI_ANALYSIS_FILE' and __import__('os').path.exists('$AI_ANALYSIS_FILE') else '[AI analysis unavailable]'
raw = '''$RAW_VIOLATIONS'''

body = f'''## 🔍 Octopus PR Quality Gate — {failure_count} Rule(s) Failed

> **Branch:** \`#{PRBranch}\` | **Checked by:** Octopus Deploy + Palmyra X5

### 🤖 AI-Assisted Analysis

{ai_text}

---

### 📋 Raw Violation Output

<details>
<summary>Click to expand full grep output</summary>

\`\`\`
{raw}
\`\`\`

</details>

---
*Triggered by [Octopus Deploy](https://octopus.schubert.life) · [View full task log](https://octopus.schubert.life/app#/Spaces-1/projects/vinifera/operations/runbooks)*
'''
print(json.dumps(body))
")

                curl -sf -X POST \
                    "https://api.github.com/repos/theonlygeranium/vinifera/issues/#{PRNumber}/comments" \
                    -H "Authorization: Bearer #{GitHubPAT}" \
                    -H "Accept: application/vnd.github+json" \
                    -H "X-GitHub-Api-Version: 2022-11-28" \
                    -d "{"body": $COMMENT_BODY}" \
                    && echo "Comment posted to PR ##{PRNumber}." \
                    || echo "WARNING: Failed to post comment — check GitHubPAT scope (needs repo or issues:write)."
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}

step "cleanup" {
    name = "Cleanup"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                source /tmp/octopus_bot_workdir 2>/dev/null || true
                [ -n "$WORK_DIR" ] && rm -rf "$WORK_DIR"
                [ -n "$RESULTS_FILE" ] && rm -f "$RESULTS_FILE" "${RESULTS_FILE}.txt"
                [ -n "$AI_ANALYSIS_FILE" ] && rm -f "$AI_ANALYSIS_FILE"
                rm -f /tmp/octopus_bot_workdir
                echo "Cleanup complete."
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}
