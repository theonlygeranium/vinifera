id = "Runbooks-23"
name = "Security Audit"
cancel_queued_tasks = true
cancel_running_tasks = false
description = "Runs npm audit on the main branch nightly. On critical or high severity CVEs, opens a GitHub issue with AI-assisted remediation guidance from Palmyra X5. Triggered on schedule by octopus-security-audit.yml."

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    quantity_to_keep = 30
    type = "Count"
}

process {
    step "checkout-main" {
        name = "Checkout Main Branch"

        action {
            action_type = "Octopus.Script"
            notes = "Clone main branch for audit. Uses shallow clone — no full history needed."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    set -e
                    REPO_URL="https://#{GitHubPAT}@github.com/theonlygeranium/vinifera.git"
                    WORK_DIR="/tmp/vinifera-audit-$$"
                    echo "Cloning main branch..."
                    git clone --depth=1 --branch main "$REPO_URL" "$WORK_DIR"
                    echo "WORK_DIR=$WORK_DIR" > /tmp/octopus_audit_workdir
                    cd "$WORK_DIR"
                    echo "Installing dependencies (npm ci)..."
                    npm ci --prefer-offline --silent 2>&1 | tail -5 || npm install --silent 2>&1 | tail -5
                    echo "Checkout complete."
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "run-npm-audit" {
        name = "Run npm audit"

        action {
            action_type = "Octopus.Script"
            notes = "Executes npm audit --json and extracts critical and high severity vulnerabilities. Saves structured output for downstream steps."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    source /tmp/octopus_audit_workdir 2>/dev/null || WORK_DIR="/tmp/vinifera-audit"
                    cd "$WORK_DIR"

                    AUDIT_FILE="/tmp/audit_output_$$"
                    SUMMARY_FILE="/tmp/audit_summary_$$"
                    echo "AUDIT_FILE=$AUDIT_FILE" >> /tmp/octopus_audit_workdir
                    echo "SUMMARY_FILE=$SUMMARY_FILE" >> /tmp/octopus_audit_workdir

                    echo "Running npm audit..."
                    npm audit --json > "$AUDIT_FILE" 2>&1 || true

                    # Parse with python3 — extract critical + high vulns
                    python3 -c "
import json, sys

try:
    with open('$AUDIT_FILE') as f:
        data = json.load(f)
except Exception as e:
    print(json.dumps({'error': str(e), 'critical': 0, 'high': 0, 'vulns': []}))
    sys.exit(0)

# npm audit v2 format (npm 7+)
vulns = []
meta = data.get('metadata', {}).get('vulnerabilities', {})
critical = meta.get('critical', 0)
high = meta.get('high', 0)
total = meta.get('total', 0)

for pkg, info in data.get('vulnerabilities', {}).items():
    sev = info.get('severity', '')
    if sev in ('critical', 'high'):
        via = info.get('via', [])
        advisories = [v for v in via if isinstance(v, dict)]
        for adv in advisories:
            vulns.append({
                'package': pkg,
                'severity': sev,
                'title': adv.get('title', 'Unknown'),
                'url': adv.get('url', ''),
                'range': adv.get('range', ''),
                'fixAvailable': info.get('fixAvailable', False)
            })

result = {
    'critical': critical,
    'high': high,
    'total': total,
    'vulns': vulns[:50]  # cap at 50 to avoid token overflow
}
with open('$SUMMARY_FILE', 'w') as f:
    json.dump(result, f, indent=2)

print(f'Critical: {critical}, High: {high}, Total: {total}')
print(f'Actionable entries extracted: {len(vulns)}')
" || echo "Python parse error — raw audit saved at $AUDIT_FILE"
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "check-for-existing-issue" {
        name = "Check for Existing Open Security Issue"

        action {
            action_type = "Octopus.Script"
            notes = "Searches GitHub Issues for an open security-audit issue. If one exists from within the last 7 days, skips issue creation to avoid duplicates."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    source /tmp/octopus_audit_workdir 2>/dev/null || true

                    EXISTING=$(curl -sf \
                        "https://api.github.com/repos/theonlygeranium/vinifera/issues?state=open&labels=security-audit&per_page=5" \
                        -H "Authorization: Bearer #{GitHubPAT}" \
                        -H "Accept: application/vnd.github+json" \
                        -H "X-GitHub-Api-Version: 2022-11-28" 2>/dev/null || echo "[]")

                    RECENT=$(echo "$EXISTING" | python3 -c "
import json, sys
from datetime import datetime, timezone, timedelta
data = json.load(sys.stdin)
cutoff = datetime.now(timezone.utc) - timedelta(days=7)
recent = [i for i in data if datetime.fromisoformat(i['created_at'].replace('Z','+00:00')) > cutoff]
print(len(recent))
" 2>/dev/null || echo "0")

                    if [ "$RECENT" -gt "0" ]; then
                        echo "SKIP_ISSUE=true — found $RECENT open security-audit issue(s) from the last 7 days." >> /tmp/octopus_audit_workdir
                        echo "Skipping issue creation: recent open security-audit issue already exists."
                    else
                        echo "No recent open security-audit issues found — will create if vulnerabilities found."
                    fi
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "ai-remediation-guidance" {
        name = "AI Remediation Guidance via Palmyra X5"

        action {
            action_type = "Octopus.Script"
            notes = "Sends the vulnerability list to Palmyra X5 via LiteLLM. Returns concise remediation steps for each CVE. Skipped if no critical/high findings."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    source /tmp/octopus_audit_workdir 2>/dev/null || true

                    if [ "$SKIP_ISSUE" = "true" ]; then
                        echo "Skipping AI step — issue suppressed."
                        exit 0
                    fi

                    if [ ! -f "$SUMMARY_FILE" ]; then
                        echo "No summary file — skipping AI."
                        exit 0
                    fi

                    CRITICAL=$(python3 -c "import json; d=json.load(open('$SUMMARY_FILE')); print(d.get('critical',0))")
                    HIGH=$(python3 -c "import json; d=json.load(open('$SUMMARY_FILE')); print(d.get('high',0))")

                    if [ "$CRITICAL" = "0" ] && [ "$HIGH" = "0" ]; then
                        echo "No critical or high vulnerabilities — skipping AI analysis."
                        echo "SKIP_ISSUE=true" >> /tmp/octopus_audit_workdir
                        exit 0
                    fi

                    AI_FILE="/tmp/audit_ai_$$"
                    echo "AI_FILE=$AI_FILE" >> /tmp/octopus_audit_workdir

                    PROMPT=$(python3 -c "
import json
data = json.load(open('$SUMMARY_FILE'))
vulns = data.get('vulns', [])
lines = []
for v in vulns:
    lines.append(f"- [{v['severity'].upper()}] {v['package']}: {v['title']} (range: {v['range']}, fix: {v['fixAvailable']}, {v['url']})")
vuln_text = '\n'.join(lines) if lines else 'No detailed advisories extracted.'
prompt = f'''You are a Node.js security engineer reviewing npm audit results for the Vinifera platform (TypeScript/Express/Supabase SaaS).

Found {data.get('critical',0)} critical and {data.get('high',0)} high severity vulnerabilities:

{vuln_text}

For each vulnerability:
1. State concisely what the risk is.
2. Provide the exact npm command to remediate it.
3. Flag if the fix is a breaking change.
Keep total response under 1500 tokens. Be direct and actionable.'''
print(json.dumps(prompt))
")

                    RESPONSE=$(curl -sf -X POST http://172.17.0.1:4000/v1/chat/completions \
                        -H "Authorization: Bearer #{LiteLLMKey}" \
                        -H "Content-Type: application/json" \
                        -d "{"model": "writer/palmyra-x5", "messages": [{"role": "user", "content": $PROMPT}], "max_tokens": 1800}" 2>&1)

                    echo "$RESPONSE" | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    print(data['choices'][0]['message']['content'])
except Exception as e:
    print(f'[AI analysis unavailable: {e}]')
" > "$AI_FILE"

                    echo "AI remediation guidance generated."
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "create-github-issue" {
        name = "Create GitHub Security Issue"

        action {
            action_type = "Octopus.Script"
            notes = "Opens a GitHub Issue labelled security-audit with the full vulnerability list and AI remediation guidance."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    source /tmp/octopus_audit_workdir 2>/dev/null || true

                    if [ "$SKIP_ISSUE" = "true" ]; then
                        echo "Issue creation suppressed."
                        exit 0
                    fi

                    if [ ! -f "$SUMMARY_FILE" ]; then
                        echo "No summary file — cannot create issue."
                        exit 0
                    fi

                    AI_TEXT="[AI analysis unavailable]"
                    [ -n "$AI_FILE" ] && [ -f "$AI_FILE" ] && AI_TEXT=$(cat "$AI_FILE")

                    ISSUE_BODY=$(python3 -c "
import json
from datetime import datetime, timezone

data = json.load(open('$SUMMARY_FILE'))
ai_text = open('$AI_FILE').read() if __import__('os').path.exists('$AI_FILE') else '[AI analysis unavailable]'
date = datetime.now(timezone.utc).strftime('%Y-%m-%d')
critical = data.get('critical', 0)
high = data.get('high', 0)
total = data.get('total', 0)
vulns = data.get('vulns', [])

rows = []
for v in vulns:
    fix = '✅ Available' if v.get('fixAvailable') else '❌ Manual'
    rows.append(f"| {v['package']} | {v['severity'].upper()} | {v['title']} | {fix} | {v.get('url','')} |")
table = '\n'.join(rows) if rows else '| (no detailed advisories extracted) | | | | |'

body = f'''## 🔐 Security Audit — {date}

> **Triggered by:** Octopus Deploy nightly security audit runbook  
> **Severity summary:** 🔴 {critical} Critical · 🟠 {high} High · Total: {total}

### Vulnerability Table

| Package | Severity | Title | Fix Available | Advisory |
|---------|----------|-------|---------------|----------|
{table}

---

### 🤖 AI-Assisted Remediation Guidance (Palmyra X5)

{ai_text}

---

### How to audit locally

\`\`\`bash
npm audit
npm audit fix          # auto-fix compatible updates
npm audit fix --force  # force major version bumps (review breaking changes first)
\`\`\`

---
*Opened by [Octopus Security Audit Runbook](https://octopus.schubert.life) · Close this issue once all critical/high findings are resolved.*
'''
print(json.dumps({'title': f'[Security Audit {date}] {critical} Critical, {high} High CVEs Detected', 'body': body, 'labels': ['security-audit', 'automated']}))
")

                    curl -sf -X POST \
                        "https://api.github.com/repos/theonlygeranium/vinifera/issues" \
                        -H "Authorization: Bearer #{GitHubPAT}" \
                        -H "Accept: application/vnd.github+json" \
                        -H "X-GitHub-Api-Version: 2022-11-28" \
                        -d "$ISSUE_BODY" \
                        && echo "GitHub security issue created." \
                        || echo "WARNING: Failed to create GitHub issue."
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "cleanup" {
        name = "Cleanup"

        action {
            action_type = "Octopus.Script"
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    source /tmp/octopus_audit_workdir 2>/dev/null || true
                    [ -n "$WORK_DIR" ] && rm -rf "$WORK_DIR"
                    [ -n "$AUDIT_FILE" ] && rm -f "$AUDIT_FILE"
                    [ -n "$SUMMARY_FILE" ] && rm -f "$SUMMARY_FILE"
                    [ -n "$AI_FILE" ] && rm -f "$AI_FILE"
                    rm -f /tmp/octopus_audit_workdir
                    echo "Cleanup complete."
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }
}
