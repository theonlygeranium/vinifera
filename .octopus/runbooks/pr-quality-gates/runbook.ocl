name = "PR Quality Gates"
cancel_queued_tasks = false
cancel_running_tasks = false
description = "Enforces 10 architectural, security, and tenancy rules from the Vinifera engineering standards."

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    quantity_to_keep = 10
    type = "Count"
}

process {
    step "checkout-pr-branch" {
        name = "Checkout PR Branch"

        action {
            action_type = "Octopus.Script"
            notes = "Resolve the trusted PR metadata through GitHub, fetch exact immutable commits without persisting the PAT, and detach the checkout."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    set -euo pipefail
                    BRANCH="#{PRBranch}"
                    WORK_DIR="/tmp/vinifera-pr-$$"
                    STATE_FILE="/tmp/octopus_pr_workdir_#{Octopus.Task.Id}"
                    github_curl() {
                        local accept="$1"
                        shift
                        printf 'header = "Authorization: Bearer %s"\nheader = "Accept: %s"\nheader = "X-GitHub-Api-Version: 2022-11-28"\n' \
                            "#{GitHubPAT}" "$accept" \
                            | curl -fsS --config - "$@"
                    }
                    PR_JSON=$(github_curl "application/vnd.github+json" \
                        "https://api.github.com/repos/theonlygeranium/vinifera/pulls/#{PRNumber}")
                    PR_METADATA=$(printf '%s' "$PR_JSON" | python3 -c '
import json, sys
data = json.load(sys.stdin)
print(data["head"]["repo"]["full_name"])
print(data["head"]["ref"])
print(data["head"]["sha"])
print(data["base"]["sha"])
print(data["commits"])
')
                    HEAD_REPOSITORY=$(printf '%s\n' "$PR_METADATA" | sed -n '1p')
                    HEAD_REF=$(printf '%s\n' "$PR_METADATA" | sed -n '2p')
                    HEAD_SHA=$(printf '%s\n' "$PR_METADATA" | sed -n '3p')
                    BASE_SHA=$(printf '%s\n' "$PR_METADATA" | sed -n '4p')
                    COMMIT_COUNT=$(printf '%s\n' "$PR_METADATA" | sed -n '5p')
                    [ "$HEAD_REPOSITORY" = "theonlygeranium/vinifera" ] || {
                        echo "FAIL: pull request head repository is not trusted"
                        exit 1
                    }
                    [ "$HEAD_REF" = "$BRANCH" ] || {
                        echo "FAIL: prompted branch does not match pull request metadata"
                        exit 1
                    }

                    mkdir -p "$WORK_DIR"
                    cd "$WORK_DIR"
                    git init --quiet
                    git remote add origin https://github.com/theonlygeranium/vinifera.git
                    GIT_CONFIG_COUNT=1 \
                    GIT_CONFIG_KEY_0=http.extraHeader \
                    GIT_CONFIG_VALUE_0="Authorization: Bearer #{GitHubPAT}" \
                        git fetch --quiet --no-tags --depth=1 origin "$BASE_SHA" "$HEAD_SHA"
                    git checkout --quiet --detach "$HEAD_SHA"
                    git remote remove origin
                    github_curl "application/vnd.github.diff" \
                        "https://api.github.com/repos/theonlygeranium/vinifera/pulls/#{PRNumber}" \
                        > "$WORK_DIR/pr.diff"

                    [ "$COMMIT_COUNT" -le 100 ] || {
                        echo "FAIL: pull request has more than 100 commits"
                        exit 1
                    }
                    COMMITS_JSON=$(github_curl "application/vnd.github+json" \
                        "https://api.github.com/repos/theonlygeranium/vinifera/pulls/#{PRNumber}/commits?per_page=100")
                    printf '%s' "$COMMITS_JSON" > "$WORK_DIR/pr-commits.json"
                    mkdir -p "$WORK_DIR/commit-diffs"
                    COMMIT_SHAS=$(printf '%s' "$COMMITS_JSON" | python3 -c '
import json, sys
data = json.load(sys.stdin)
expected = int(sys.argv[1])
if len(data) != expected:
    raise SystemExit(f"FAIL: expected {expected} PR commits, received {len(data)}")
for commit in data:
    print(commit["sha"])
' "$COMMIT_COUNT")
                    while IFS= read -r commit_sha; do
                        github_curl "application/vnd.github.diff" \
                            "https://api.github.com/repos/theonlygeranium/vinifera/commits/$commit_sha" \
                            > "$WORK_DIR/commit-diffs/$commit_sha.diff"
                    done <<< "$COMMIT_SHAS"
                    unset PR_JSON PR_METADATA COMMITS_JSON COMMIT_SHAS

                    {
                        echo "WORK_DIR=$WORK_DIR"
                        echo "HEAD_SHA=$HEAD_SHA"
                        echo "BASE_SHA=$BASE_SHA"
                    } > "$STATE_FILE"
                    echo "Checkout complete: $WORK_DIR"
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "rule-1-no-direct-route-to-database-access" {
        name = "Rule 1: No Direct Route-to-Database Access"

        action {
            action_type = "Octopus.Script"
            notes = "Route handlers in server/routes/ must not create Supabase clients or query the database directly."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    source "/tmp/octopus_pr_workdir_#{Octopus.Task.Id}" 2>/dev/null || WORK_DIR="/tmp/vinifera-pr"
                    cd "$WORK_DIR"
                    grep -rn --include="*.ts" -E "createClient\s*\(|from [\"']@supabase/supabase-js[\"']" server/routes/ 2>/dev/null && echo "FAIL: Direct DB access in routes" && exit 1 || echo "PASS: Rule 1"
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "rule-2-no-circular-imports-between-layers" {
        name = "Rule 2: No Circular Imports Between Layers"

        action {
            action_type = "Octopus.Script"
            notes = "server/services/ must not import from server/routes/. Routes must not import from server/integrations/ directly."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    source "/tmp/octopus_pr_workdir_#{Octopus.Task.Id}" 2>/dev/null || WORK_DIR="/tmp/vinifera-pr"
                    cd "$WORK_DIR"
                    V1=$(grep -rn --include="*.ts" "from.*server/routes" server/services/ 2>/dev/null||true)
                    V2=$(grep -rn --include="*.ts" "from.*server/integrations" server/routes/ 2>/dev/null||true)
                    [ -n "$V1" ] && echo "FAIL services->routes: $V1" && exit 1
                    [ -n "$V2" ] && echo "FAIL routes->integrations: $V2" && exit 1
                    echo "PASS: Rule 2"
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "rule-3-no-provider-secrets-in-source" {
        name = "Rule 3: No Provider Secrets in Source"

        action {
            action_type = "Octopus.Script"
            notes = "TypeScript source files must not contain string literals matching sk_live_, sk_test_, rk_live_, ep_test_, or re_ patterns."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    source "/tmp/octopus_pr_workdir_#{Octopus.Task.Id}" 2>/dev/null || WORK_DIR="/tmp/vinifera-pr"
                    cd "$WORK_DIR"
                    VIOLATIONS=$(grep -rn --include="*.ts" -E "(sk_live_|sk_test_|rk_live_|ep_test_|re_)[A-Za-z0-9_]+" server/ src/ 2>/dev/null||true)
                    [ -n "$VIOLATIONS" ] && echo "FAIL: $VIOLATIONS" && exit 1
                    echo "PASS: Rule 3"
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "rules-4-through-10-change-aware-guards" {
        name = "Rules 4-10: Change-Aware Security and Tenancy Guards"

        action {
            action_type = "Octopus.Script"
            notes = "Evaluate GitHub's merge-base-aware PR diff and per-commit diffs so input validation, auth, provider, idempotency, tenancy, changelog, and type rules fail closed without grandfathered baseline noise."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    set -euo pipefail
                    source "/tmp/octopus_pr_workdir_#{Octopus.Task.Id}"
                    cd "$WORK_DIR"
                    python3 - "$WORK_DIR" "$WORK_DIR/pr.diff" "$WORK_DIR/commit-diffs" <<'PY'
import pathlib
import re
import shlex
import sys

work_dir = pathlib.Path(sys.argv[1]).resolve()
diff_lines = pathlib.Path(sys.argv[2]).read_text(
    encoding="utf-8", errors="replace"
).splitlines()
commit_diff_dir = pathlib.Path(sys.argv[3]).resolve()
added = []
removed = []
affected_new_lines = {}
changed_files = set()
path = None
old_line = None
new_line = None

for line in diff_lines:
    if line.startswith("diff --git "):
        parts = shlex.split(line)
        path = parts[3][2:] if len(parts) >= 4 and parts[3].startswith("b/") else None
        if path:
            changed_files.add(path)
        old_line = None
        new_line = None
        continue
    match = re.match(
        r"^@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@",
        line,
    )
    if match:
        old_line = int(match.group(1))
        new_line = int(match.group(2))
        continue
    if path is None or old_line is None or new_line is None:
        continue
    if line.startswith("+") and not line.startswith("+++"):
        added.append((path, new_line, line[1:]))
        affected_new_lines.setdefault(path, set()).add(new_line)
        new_line += 1
    elif line.startswith("-") and not line.startswith("---"):
        removed.append((path, old_line, max(1, new_line), line[1:]))
        affected_new_lines.setdefault(path, set()).add(max(1, new_line))
        old_line += 1
        continue
    elif not line.startswith("\\"):
        old_line += 1
        new_line += 1

failures = []

def source_window(file_path, line_number, before=8, after=24):
    candidate = (work_dir / file_path).resolve()
    if work_dir not in candidate.parents or not candidate.is_file():
        return ""
    lines = candidate.read_text(encoding="utf-8", errors="replace").splitlines()
    start = max(0, line_number - 1 - before)
    end = min(len(lines), line_number + after)
    return "\n".join(lines[start:end])

def mask_non_code(source):
    masked = list(source)
    state = "code"
    index = 0
    while index < len(source):
        char = source[index]
        next_char = source[index + 1] if index + 1 < len(source) else ""
        if state == "code":
            if char == "/" and next_char == "/":
                masked[index] = masked[index + 1] = " "
                state = "line-comment"
                index += 2
                continue
            if char == "/" and next_char == "*":
                masked[index] = masked[index + 1] = " "
                state = "block-comment"
                index += 2
                continue
            if char in ("'", '"', "`"):
                masked[index] = " "
                state = char
        elif state == "line-comment":
            if char == "\n":
                state = "code"
            else:
                masked[index] = " "
        elif state == "block-comment":
            masked[index] = " "
            if char == "*" and next_char == "/":
                masked[index + 1] = " "
                state = "code"
                index += 2
                continue
        else:
            masked[index] = " "
            if char == "\\":
                if index + 1 < len(source):
                    masked[index + 1] = " "
                    index += 2
                    continue
            elif char == state:
                state = "code"
        index += 1
    return "".join(masked)

def has_tenant_predicate(source):
    masked = mask_non_code(source)
    for match in re.finditer(r"\.(?:eq|in)\s*\(", masked):
        argument = source[match.end():]
        if re.match(
            r"\s*(['\"])(?:brand_id|organization_id)\1\s*,",
            argument,
        ):
            return True
    return bool(
        re.search(
            r"\.match\s*\(\s*\{[^}]*\b(?:brand_id|organization_id)\b",
            masked,
            re.DOTALL,
        )
    )

def tenant_query_segments(file_path):
    candidate = (work_dir / file_path).resolve()
    if work_dir not in candidate.parents or not candidate.is_file():
        return []
    source = candidate.read_text(encoding="utf-8", errors="replace")
    masked = mask_non_code(source)
    utility_receivers = {
        "Array",
        "ArrayBuffer",
        "BigInt64Array",
        "BigUint64Array",
        "Buffer",
        "Float32Array",
        "Float64Array",
        "Int8Array",
        "Int16Array",
        "Int32Array",
        "Object",
        "Set",
        "Uint8Array",
        "Uint8ClampedArray",
        "Uint16Array",
        "Uint32Array",
    }
    from_calls = []
    for match in re.finditer(r"\.from\s*\(", masked):
        receiver_match = re.search(
            r"([A-Za-z_$][A-Za-z0-9_$]*)\s*$",
            masked[:match.start()],
        )
        if receiver_match and receiver_match.group(1) in utility_receivers:
            continue
        from_calls.append(match)
    segments = []
    for index, from_call in enumerate(from_calls):
        next_from = (
            from_calls[index + 1].start()
            if index + 1 < len(from_calls)
            else len(source)
        )
        semicolon = masked.find(";", from_call.end(), next_from)
        end = semicolon + 1 if semicolon >= 0 else next_from
        segment = source[from_call.start():end]
        masked_segment = masked[from_call.start():end]
        if not re.search(
            r"\.(?:select|update|delete|insert|upsert)\s*\(",
            masked_segment,
        ):
            continue
        start_line = source.count("\n", 0, from_call.start()) + 1
        end_line = source.count("\n", 0, end) + 1
        segments.append((start_line, end_line, segment))
    return segments

added_by_file = {}
for file_path, line_number, text in added:
    added_by_file.setdefault(file_path, []).append((line_number, text))

for file_path, line_number, replacement_anchor, text in removed:
    if not file_path.startswith("server/services/") or not file_path.endswith(".ts"):
        continue
    if not has_tenant_predicate(text):
        continue
    nearby_additions = "\n".join(
        added_text
        for added_line, added_text in added_by_file.get(file_path, [])
        if abs(added_line - replacement_anchor) <= 3
    )
    if has_tenant_predicate(nearby_additions):
        continue
    failures.append(("Rule 8", f"{file_path}:{line_number}", text.strip()))

for file_path, affected_lines in affected_new_lines.items():
    if not file_path.startswith("server/services/") or not file_path.endswith(".ts"):
        continue
    for start_line, end_line, segment in tenant_query_segments(file_path):
        if not any(start_line - 2 <= line <= end_line + 2 for line in affected_lines):
            continue
        if not has_tenant_predicate(segment):
            excerpt = next(
                (
                    line.strip()
                    for line in segment.splitlines()
                    if re.search(
                        r"\.(?:select|update|delete|insert|upsert)\s*\(",
                        mask_non_code(line),
                    )
                ),
                segment.strip(),
            )
            failures.append(("Rule 8", f"{file_path}:{start_line}", excerpt))

for file_path, line_number, text in added:
    if not file_path.startswith("server/") or not file_path.endswith(".ts"):
        continue
    window = source_window(file_path, line_number)
    masked_text = mask_non_code(text)
    masked_window = mask_non_code(window)
    location = f"{file_path}:{line_number}"
    is_test_file = ".test." in file_path or file_path.startswith("tests/")
    is_native_boundary = bool(
        re.search(r"(?:^|/)(?:mobile|native)(?:/|[-_.])", file_path)
    )

    if file_path.startswith("server/routes/") and re.search(r"\breq\.(?:body|params)\b", masked_text):
        if not re.search(r"(?:safeParse|\.parse)\s*\(", masked_window):
            failures.append(("Rule 4", location, text))

    inbound_auth = False
    for match in re.finditer(
        r"\b(?:request|req)\.(?:get|header)\s*\(",
        masked_text,
        re.IGNORECASE,
    ):
        if re.match(
            r"\s*(['\"])authorization\1",
            text[match.end():],
            re.IGNORECASE,
        ):
            inbound_auth = True
            break
    if inbound_auth and not (is_test_file or is_native_boundary):
        failures.append(("Rule 5", location, text))

    if (
        (file_path.startswith("server/services/") or file_path.startswith("server/integrations/"))
        and not is_test_file
        and re.search(r"\b(?:easypost|resend|stripe)\.", masked_text, re.IGNORECASE)
        and not re.search(r"\b(?:isActive|isEnabled|activation)\b", masked_window)
    ):
        failures.append(("Rule 6", location, text))

    if re.search(r"(?:paymentIntents\.create|labels\.create|emails\.send)", masked_text):
        if not re.search(r"\bidempotency(?:Key)?\b", masked_window, re.IGNORECASE):
            failures.append(("Rule 7", location, text))

    if re.search(r":[ \t]*any\b|\bas[ \t]+any\b", masked_text):
        failures.append(("Rule 10", location, text))

for commit_diff in sorted(commit_diff_dir.glob("*.diff")):
    commit_files = set()
    for line in commit_diff.read_text(
        encoding="utf-8", errors="replace"
    ).splitlines():
        if not line.startswith("diff --git "):
            continue
        parts = shlex.split(line)
        if len(parts) >= 4 and parts[3].startswith("b/"):
            commit_files.add(parts[3][2:])
    if commit_files and "CHANGELOG.md" not in commit_files:
        failures.append(
            ("Rule 9", commit_diff.stem, ", ".join(sorted(commit_files)))
        )

if failures:
    for rule, location, text in failures:
        print(f"FAIL {rule}: {location}: {text}")
    raise SystemExit(1)
PY
                    echo "PASS: Rules 4-10"
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "cleanup-workdir" {
        name = "Cleanup Work Directory"

        action {
            action_type = "Octopus.Script"
            notes = "Remove the cloned repository from the Octopus server."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    STATE_FILE="/tmp/octopus_pr_workdir_#{Octopus.Task.Id}"
                    source "$STATE_FILE" 2>/dev/null || true
                    [ -n "$WORK_DIR" ] && rm -rf "$WORK_DIR" && echo "Cleaned up $WORK_DIR"
                    rm -f "$STATE_FILE"
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }
}
