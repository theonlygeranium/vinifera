name = "PR Quality Gates"
cancel_queued_tasks = false
cancel_running_tasks = false
description = "Enforces 10 architectural, security, and tenancy rules from the Vinifera engineering standards."

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    quantity_to_keep = 10
    type = "Count"
}

process {
    step "checkout-pr-branch" {
        name = "Checkout PR Branch"

        action {
            action_type = "Octopus.Script"
            notes = "Resolve the trusted PR metadata through GitHub, fetch exact immutable commits without persisting the PAT, and detach the checkout."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    set -euo pipefail
                    BRANCH="#{PRBranch}"
                    EXPECTED_BASE_REF="#{ExpectedBaseRef}"
                    EXPECTED_BASE_SHA="#{ExpectedBaseSHA}"
                    EXPECTED_HEAD_SHA="#{ExpectedHeadSHA}"
                    WORK_DIR="/tmp/vinifera-pr-$$"
                    STATE_FILE="/tmp/octopus_pr_workdir_#{Octopus.Task.Id}"
                    github_curl() {
                        local accept="$1"
                        shift
                        printf 'header = "Authorization: Bearer %s"\nheader = "Accept: %s"\nheader = "X-GitHub-Api-Version: 2022-11-28"\n' \
                            "#{GitHubPAT}" "$accept" \
                            | curl -fsS --config - "$@"
                    }
                    PR_JSON=$(github_curl "application/vnd.github+json" \
                        "https://api.github.com/repos/theonlygeranium/vinifera/pulls/#{PRNumber}")
                    PR_METADATA=$(printf '%s' "$PR_JSON" | python3 -c '
import json, sys
data = json.load(sys.stdin)
print(data["head"]["repo"]["full_name"])
print(data["head"]["ref"])
print(data["head"]["sha"])
print(data["base"]["ref"])
print(data["base"]["sha"])
')
                    HEAD_REPOSITORY=$(printf '%s\n' "$PR_METADATA" | sed -n '1p')
                    HEAD_REF=$(printf '%s\n' "$PR_METADATA" | sed -n '2p')
                    HEAD_SHA=$(printf '%s\n' "$PR_METADATA" | sed -n '3p')
                    BASE_REF=$(printf '%s\n' "$PR_METADATA" | sed -n '4p')
                    BASE_SHA=$(printf '%s\n' "$PR_METADATA" | sed -n '5p')
                    [ "$HEAD_REPOSITORY" = "theonlygeranium/vinifera" ] || {
                        echo "FAIL: pull request head repository is not trusted"
                        exit 1
                    }
                    [ "$HEAD_REF" = "$BRANCH" ] || {
                        echo "FAIL: prompted branch does not match pull request metadata"
                        exit 1
                    }
                    [[ "$EXPECTED_HEAD_SHA" =~ ^[0-9a-f]{40}$ ]] || {
                        echo "FAIL: expected head is not an exact commit SHA"
                        exit 1
                    }
                    [ "$HEAD_SHA" = "$EXPECTED_HEAD_SHA" ] || {
                        echo "FAIL: pull request head changed before Octopus checkout"
                        exit 1
                    }
                    [[ "$EXPECTED_BASE_SHA" =~ ^[0-9a-f]{40}$ ]] || {
                        echo "FAIL: expected base is not an exact commit SHA"
                        exit 1
                    }
                    [ "$BASE_REF" = "$EXPECTED_BASE_REF" ] || {
                        echo "FAIL: pull request base ref changed before Octopus checkout"
                        exit 1
                    }
                    [ "$BASE_SHA" = "$EXPECTED_BASE_SHA" ] || {
                        echo "FAIL: pull request base SHA changed before Octopus checkout"
                        exit 1
                    }

                    mkdir -p "$WORK_DIR"
                    cd "$WORK_DIR"
                    git init --quiet
                    git remote add origin https://github.com/theonlygeranium/vinifera.git
                    GIT_CONFIG_COUNT=1 \
                    GIT_CONFIG_KEY_0=http.extraHeader \
                    GIT_CONFIG_VALUE_0="Authorization: Bearer #{GitHubPAT}" \
                        git fetch --quiet --no-tags --depth=100 origin "$BASE_SHA" "$HEAD_SHA"
                    MERGE_BASE_SHA=$(git merge-base "$BASE_SHA" "$HEAD_SHA") || {
                        echo "FAIL: unable to resolve pull request merge base"
                        exit 1
                    }
                    git checkout --quiet --detach "$HEAD_SHA"
                    git remote remove origin
                    git diff --no-ext-diff "$MERGE_BASE_SHA" "$HEAD_SHA" \
                        > "$WORK_DIR/pr.diff"

                    mapfile -t COMMIT_SHAS < <(
                        git rev-list --reverse "$MERGE_BASE_SHA..$HEAD_SHA"
                    )
                    [ "${#COMMIT_SHAS[@]}" -le 100 ] || {
                        echo "FAIL: pull request has more than 100 commits"
                        exit 1
                    }
                    mkdir -p "$WORK_DIR/commit-diffs"
                    for commit_sha in "${COMMIT_SHAS[@]}"; do
                        git show --format= --no-ext-diff --first-parent "$commit_sha" \
                            > "$WORK_DIR/commit-diffs/$commit_sha.diff"
                    done
                    unset PR_JSON PR_METADATA COMMIT_SHAS

                    {
                        echo "WORK_DIR=$WORK_DIR"
                        echo "HEAD_SHA=$HEAD_SHA"
                        echo "BASE_SHA=$BASE_SHA"
                        echo "MERGE_BASE_SHA=$MERGE_BASE_SHA"
                    } > "$STATE_FILE"
                    echo "Checkout complete: $WORK_DIR"
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "rule-1-no-direct-route-to-database-access" {
        name = "Rule 1: No Direct Route-to-Database Access"

        action {
            action_type = "Octopus.Script"
            notes = "Route handlers in server/routes/ must not create Supabase clients or query the database directly."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    source "/tmp/octopus_pr_workdir_#{Octopus.Task.Id}" 2>/dev/null || WORK_DIR="/tmp/vinifera-pr"
                    cd "$WORK_DIR"
                    grep -rn --include="*.ts" -E "createClient\s*\(|from [\"']@supabase/supabase-js[\"']" server/routes/ 2>/dev/null && echo "FAIL: Direct DB access in routes" && exit 1 || echo "PASS: Rule 1"
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "rule-2-no-circular-imports-between-layers" {
        name = "Rule 2: No Circular Imports Between Layers"

        action {
            action_type = "Octopus.Script"
            notes = "server/services/ must not import from server/routes/. Routes must not import from server/integrations/ directly."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    source "/tmp/octopus_pr_workdir_#{Octopus.Task.Id}" 2>/dev/null || WORK_DIR="/tmp/vinifera-pr"
                    cd "$WORK_DIR"
                    V1=$(grep -rn --include="*.ts" "from.*server/routes" server/services/ 2>/dev/null||true)
                    V2=$(grep -rn --include="*.ts" "from.*server/integrations" server/routes/ 2>/dev/null||true)
                    [ -n "$V1" ] && echo "FAIL services->routes: $V1" && exit 1
                    [ -n "$V2" ] && echo "FAIL routes->integrations: $V2" && exit 1
                    echo "PASS: Rule 2"
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "rule-3-no-provider-secrets-in-source" {
        name = "Rule 3: No Provider Secrets in Source"

        action {
            action_type = "Octopus.Script"
            notes = "TypeScript source files must not contain string literals matching sk_live_, sk_test_, rk_live_, ep_test_, or re_ patterns."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    source "/tmp/octopus_pr_workdir_#{Octopus.Task.Id}" 2>/dev/null || WORK_DIR="/tmp/vinifera-pr"
                    cd "$WORK_DIR"
                    VIOLATIONS=$(grep -rn --include="*.ts" -E "(sk_live_|sk_test_|rk_live_|ep_test_|re_)[A-Za-z0-9_]+" server/ src/ 2>/dev/null||true)
                    [ -n "$VIOLATIONS" ] && echo "FAIL: $VIOLATIONS" && exit 1
                    echo "PASS: Rule 3"
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "rules-4-through-10-change-aware-guards" {
        name = "Rules 4-10: Change-Aware Security and Tenancy Guards"

        action {
            action_type = "Octopus.Script"
            notes = "Evaluate GitHub's merge-base-aware PR diff and per-commit diffs so input validation, auth, provider, idempotency, tenancy, changelog, and type rules fail closed without grandfathered baseline noise."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    set -euo pipefail
                    source "/tmp/octopus_pr_workdir_#{Octopus.Task.Id}"
                    cd "$WORK_DIR"
                    python3 - "$WORK_DIR" "$WORK_DIR/pr.diff" "$WORK_DIR/commit-diffs" "$MERGE_BASE_SHA" <<'PY'
import pathlib
import re
import shlex
import subprocess
import sys
from collections import Counter

work_dir = pathlib.Path(sys.argv[1]).resolve()
diff_lines = pathlib.Path(sys.argv[2]).read_text(
    encoding="utf-8", errors="replace"
).splitlines()
commit_diff_dir = pathlib.Path(sys.argv[3]).resolve()
base_sha = sys.argv[4] if len(sys.argv) > 4 else ""
added = []
changed_files = set()
path = None
new_line = None

for line in diff_lines:
    if line.startswith("diff --git "):
        parts = shlex.split(line)
        path = parts[3][2:] if len(parts) >= 4 and parts[3].startswith("b/") else None
        if path:
            changed_files.add(path)
        new_line = None
        continue
    match = re.match(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@", line)
    if match:
        new_line = int(match.group(1))
        continue
    if path is None or new_line is None:
        continue
    if line.startswith("+") and not line.startswith("+++"):
        added.append((path, new_line, line[1:]))
        new_line += 1
    elif line.startswith("-") and not line.startswith("---"):
        continue
    elif not line.startswith("\\"):
        new_line += 1

failures = []

def source_window(file_path, line_number, before=8, after=24):
    candidate = (work_dir / file_path).resolve()
    if work_dir not in candidate.parents or not candidate.is_file():
        return ""
    lines = candidate.read_text(encoding="utf-8", errors="replace").splitlines()
    start = max(0, line_number - 1 - before)
    end = min(len(lines), line_number + after)
    return "\n".join(lines[start:end])

def mask_non_code(source):
    masked = list(source)
    state = "code"
    index = 0
    while index < len(source):
        char = source[index]
        next_char = source[index + 1] if index + 1 < len(source) else ""
        if state == "code":
            if char == "/" and next_char == "/":
                masked[index] = masked[index + 1] = " "
                state = "line-comment"
                index += 2
                continue
            if char == "/" and next_char == "*":
                masked[index] = masked[index + 1] = " "
                state = "block-comment"
                index += 2
                continue
            if char in ("'", '"', "`"):
                masked[index] = " "
                state = char
        elif state == "line-comment":
            if char == "\n":
                state = "code"
            else:
                masked[index] = " "
        elif state == "block-comment":
            masked[index] = " "
            if char == "*" and next_char == "/":
                masked[index + 1] = " "
                state = "code"
                index += 2
                continue
        else:
            masked[index] = " "
            if char == "\\":
                if index + 1 < len(source):
                    masked[index + 1] = " "
                    index += 2
                    continue
            elif char == state:
                state = "code"
        index += 1
    return "".join(masked)

def has_tenant_predicate(source):
    masked = mask_non_code(source)
    for match in re.finditer(r"\.(?:eq|in)\s*\(", masked):
        argument = source[match.end():]
        if re.match(
            r"\s*(['\"])(?:brand_id|organization_id)\1\s*,",
            argument,
        ):
            return True
    return bool(
        re.search(
            r"\.match\s*\(\s*\{[^}]*\b(?:brand_id|organization_id)\b",
            masked,
            re.DOTALL,
        )
    )

def statement_spans(masked):
    start = 0
    spans = []
    parenthesis_depth = 0
    for index, char in enumerate(masked):
        if char == "(":
            parenthesis_depth += 1
        elif char == ")":
            parenthesis_depth = max(0, parenthesis_depth - 1)
        elif char == ";" and parenthesis_depth == 0:
            spans.append((start, index + 1))
            start = index + 1
    if start < len(masked):
        spans.append((start, len(masked)))
    return spans

def brace_depth(masked, position):
    prefix = masked[:position]
    return prefix.count("{") - prefix.count("}")

def enclosing_block_end(masked, position):
    base_depth = brace_depth(masked, position)
    depth = base_depth
    for index in range(position, len(masked)):
        if masked[index] == "{":
            depth += 1
        elif masked[index] == "}":
            depth -= 1
            if depth < base_depth:
                return index
    return len(masked)

def database_from_calls(masked):
    utility_receivers = {
        "Array",
        "ArrayBuffer",
        "BigInt64Array",
        "BigUint64Array",
        "Buffer",
        "Float32Array",
        "Float64Array",
        "Int8Array",
        "Int16Array",
        "Int32Array",
        "Object",
        "Set",
        "Uint8Array",
        "Uint8ClampedArray",
        "Uint16Array",
        "Uint32Array",
    }
    from_calls = []
    for match in re.finditer(r"\.from\s*\(", masked):
        receiver_match = re.search(
            r"([A-Za-z_$][A-Za-z0-9_$]*)\s*$",
            masked[:match.start()],
        )
        if receiver_match and receiver_match.group(1) in utility_receivers:
            continue
        from_calls.append(match)
    return from_calls

def query_models(source):
    masked = mask_non_code(source)
    spans = statement_spans(masked)
    from_calls = database_from_calls(masked)
    rooted_variables = {
        match.group(1)
        for match in re.finditer(
            r"(?:const|let|var)\s+([A-Za-z_$][A-Za-z0-9_$]*)"
            r"\s*=\s*(?:await\s*)?[^;]*\.from\s*\(",
            masked,
        )
    }
    models = []
    for statement_start, statement_end in spans:
        statement_calls = [
            match
            for match in from_calls
            if statement_start <= match.start() < statement_end
        ]
        for index, from_call in enumerate(statement_calls):
            receiver_match = re.search(
                r"([A-Za-z_$][A-Za-z0-9_$]*"
                r"(?:\s*(?:\.|\?\.)\s*[A-Za-z_$][A-Za-z0-9_$]*)*)\s*$",
                masked[statement_start:from_call.start()],
            )
            segment_start = (
                statement_start + receiver_match.start(1)
                if receiver_match
                else from_call.start()
            )
            end = (
                statement_calls[index + 1].start()
                if index + 1 < len(statement_calls)
                else statement_end
            )
            segment = source[segment_start:end]
            prefix = masked[statement_start:from_call.start()]
            variable_match = re.search(
                r"(?:const|let|var)\s+([A-Za-z_$][A-Za-z0-9_$]*)"
                r"\s*=\s*(?:await\s*)?[^;]*$",
                prefix,
            )
            if not variable_match:
                variable_match = re.search(
                    r"(?:^|\n)\s*([A-Za-z_$][A-Za-z0-9_$]*)"
                    r"\s*=\s*(?:await\s*)?[^;]*$",
                    prefix,
                )
            variable = variable_match.group(1) if variable_match else None
            candidates = []
            if variable:
                paths = {
                    variable: {
                        "parts": [segment],
                        "end": end,
                        "has_child": False,
                    }
                }
                terminals = []
                base_depth = brace_depth(masked, from_call.start())
                block_end = enclosing_block_end(masked, from_call.start())
                for later_start, later_end in spans:
                    if later_start < statement_end:
                        continue
                    if later_start >= block_end:
                        break
                    later_depth = brace_depth(masked, later_start)
                    if later_depth != base_depth:
                        continue
                    later_masked = masked[later_start:later_end]
                    direct_use = None
                    receiver = None
                    for tracked in list(paths):
                        candidate = re.search(
                            r"^\s*(?:(?:const|let|var)\s+"
                            r"([A-Za-z_$][A-Za-z0-9_$]*)\s*=\s*"
                            r"(?:await\s*)?|"
                            r"([A-Za-z_$][A-Za-z0-9_$]*)\s*=\s*"
                            r"(?:await\s*)?|return\s+(?:await\s*)?|await\s+)"
                            rf"{re.escape(tracked)}\."
                            r"(?:select|update|delete|insert|upsert|eq|in|match)"
                            r"\s*\(",
                            later_masked,
                        )
                        if candidate:
                            direct_use = candidate
                            receiver = tracked
                            break
                    if direct_use is None or receiver is None:
                        continue
                    parent = paths[receiver]
                    statement = source[later_start:later_end]
                    assignment = direct_use.group(1) or direct_use.group(2)
                    if assignment:
                        if assignment == receiver:
                            parent["parts"].append(statement)
                            parent["end"] = later_end
                        else:
                            parent["has_child"] = True
                            paths[assignment] = {
                                "parts": [*parent["parts"], statement],
                                "end": later_end,
                                "has_child": False,
                            }
                    else:
                        parent["has_child"] = True
                        terminals.append(
                            {
                                "parts": [*parent["parts"], statement],
                                "end": later_end,
                                "has_child": False,
                            }
                        )
                candidates = [
                    *terminals,
                    *(
                        path
                        for path in paths.values()
                        if not path["has_child"]
                    ),
                ]
            else:
                candidates = [
                    {"parts": [segment], "end": end, "has_child": False}
                ]
            for candidate in candidates:
                model = "\n".join(candidate["parts"])
                if not re.search(
                    r"\.(?:select|update|delete|insert|upsert)\s*\(",
                    mask_non_code(model),
                ):
                    continue
                start_line = source.count("\n", 0, segment_start) + 1
                end_line = source.count("\n", 0, candidate["end"]) + 1
                models.append(
                    (
                        start_line,
                        end_line,
                        model,
                        receiver_match is not None,
                    )
                )
        if statement_calls:
            continue
        statement_masked = masked[statement_start:statement_end]
        operation = re.search(
            r"([A-Za-z_$][A-Za-z0-9_$]*)\s*\."
            r"(?:select|update|delete|insert|upsert)\s*\(",
            statement_masked,
        )
        if operation and operation.group(1) not in rooted_variables:
            model = source[statement_start:statement_end]
            start_line = source.count("\n", 0, statement_start) + 1
            end_line = source.count("\n", 0, statement_end) + 1
            models.append((start_line, end_line, model, True))
    return models

def query_fingerprint(model):
    return re.sub(r"\s+", "", model)

def base_file_source(file_path):
    if not base_sha:
        return ""
    try:
        result = subprocess.run(
            ["git", "show", f"{base_sha}:{file_path}"],
            cwd=work_dir,
            check=False,
            capture_output=True,
            text=True,
            timeout=10,
        )
    except subprocess.TimeoutExpired:
        print(
            f"WARN Rule 8: timed out reading base source for {file_path}",
            file=sys.stderr,
        )
        return ""
    if result.returncode != 0:
        print(
            f"WARN Rule 8: base source unavailable for {file_path}",
            file=sys.stderr,
        )
    return result.stdout if result.returncode == 0 else ""

for file_path in changed_files:
    if not file_path.startswith("server/services/") or not file_path.endswith(".ts"):
        continue
    candidate = (work_dir / file_path).resolve()
    if work_dir not in candidate.parents or not candidate.is_file():
        continue
    head_source = candidate.read_text(encoding="utf-8", errors="replace")
    base_unscoped = Counter(
        query_fingerprint(model)
        for _, _, model, receiver_known in query_models(
            base_file_source(file_path)
        )
        if receiver_known and not has_tenant_predicate(model)
    )
    for start_line, _, model, _ in query_models(head_source):
        if has_tenant_predicate(model):
            continue
        fingerprint = query_fingerprint(model)
        if base_unscoped[fingerprint] > 0:
            base_unscoped[fingerprint] -= 1
            continue
        excerpt = next(
            (
                line.strip()
                for line in model.splitlines()
                if re.search(
                    r"\.(?:select|update|delete|insert|upsert)\s*\(",
                    mask_non_code(line),
                )
            ),
            model.strip(),
        )
        failures.append(("Rule 8", f"{file_path}:{start_line}", excerpt))

for file_path, line_number, text in added:
    if not file_path.startswith("server/") or not file_path.endswith(".ts"):
        continue
    window = source_window(file_path, line_number)
    masked_text = mask_non_code(text)
    masked_window = mask_non_code(window)
    location = f"{file_path}:{line_number}"
    is_test_file = ".test." in file_path or file_path.startswith("tests/")
    is_native_boundary = bool(
        re.search(r"(?:^|/)(?:mobile|native)(?:/|[-_.])", file_path)
    )

    if file_path.startswith("server/routes/") and re.search(r"\breq\.(?:body|params)\b", masked_text):
        if not re.search(r"(?:safeParse|\.parse)\s*\(", masked_window):
            failures.append(("Rule 4", location, text))

    inbound_auth = False
    for match in re.finditer(
        r"\b(?:request|req)\.(?:get|header)\s*\(",
        masked_text,
        re.IGNORECASE,
    ):
        if re.match(
            r"\s*(['\"])authorization\1",
            text[match.end():],
            re.IGNORECASE,
        ):
            inbound_auth = True
            break
    if inbound_auth and not (is_test_file or is_native_boundary):
        failures.append(("Rule 5", location, text))

    if (
        (file_path.startswith("server/services/") or file_path.startswith("server/integrations/"))
        and not is_test_file
        and re.search(r"\b(?:easypost|resend|stripe)\.", masked_text, re.IGNORECASE)
        and not re.search(r"\b(?:isActive|isEnabled|activation)\b", masked_window)
    ):
        failures.append(("Rule 6", location, text))

    if re.search(r"(?:paymentIntents\.create|labels\.create|emails\.send)", masked_text):
        if not re.search(r"\bidempotency(?:Key)?\b", masked_window, re.IGNORECASE):
            failures.append(("Rule 7", location, text))

    if re.search(r":[ \t]*any\b|\bas[ \t]+any\b", masked_text):
        failures.append(("Rule 10", location, text))

for commit_diff in sorted(commit_diff_dir.glob("*.diff")):
    commit_files = set()
    for line in commit_diff.read_text(
        encoding="utf-8", errors="replace"
    ).splitlines():
        if not line.startswith("diff --git "):
            continue
        parts = shlex.split(line)
        if len(parts) >= 4 and parts[3].startswith("b/"):
            commit_files.add(parts[3][2:])
    if commit_files and "CHANGELOG.md" not in commit_files:
        failures.append(
            ("Rule 9", commit_diff.stem, ", ".join(sorted(commit_files)))
        )

if failures:
    for rule, location, text in failures:
        print(f"FAIL {rule}: {location}: {text}")
    raise SystemExit(1)
PY
                    echo "PASS: Rules 4-10"
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "cleanup-workdir" {
        name = "Cleanup Work Directory"

        action {
            action_type = "Octopus.Script"
            notes = "Remove the cloned repository from the Octopus server."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    STATE_FILE="/tmp/octopus_pr_workdir_#{Octopus.Task.Id}"
                    source "$STATE_FILE" 2>/dev/null || true
                    [ -n "$WORK_DIR" ] && rm -rf "$WORK_DIR" && echo "Cleaned up $WORK_DIR"
                    rm -f "$STATE_FILE"
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }
}
