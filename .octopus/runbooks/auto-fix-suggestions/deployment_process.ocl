step "checkout-pr-branch" {
    name = "Checkout PR Branch"

    action {
        action_type = "Octopus.Script"
        notes = "Clone the PR branch into a temp directory and install node_modules."
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                set -e
                REPO_URL="https://#{GitHubPAT}@github.com/theonlygeranium/vinifera.git"
                BRANCH="#{PRBranch}"
                WORK_DIR="/tmp/vinifera-autofix-$$"
                echo "Cloning branch: $BRANCH"
                git clone --depth=1 --branch "$BRANCH" "$REPO_URL" "$WORK_DIR"
                echo "WORK_DIR=$WORK_DIR" > /tmp/octopus_autofix_workdir
                cd "$WORK_DIR"
                echo "Installing dependencies (npm ci)..."
                npm ci --prefer-offline --silent 2>&1 | tail -5 || npm install --silent 2>&1 | tail -5
                echo "Checkout and install complete."
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}

step "run-eslint-fix-and-prettier" {
    name = "Run ESLint Fix and Prettier"

    action {
        action_type = "Octopus.Script"
        notes = "Applies eslint --fix and prettier --write to changed TS files. Records the git diff of changes made."
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                source /tmp/octopus_autofix_workdir 2>/dev/null || WORK_DIR="/tmp/vinifera-autofix"
                cd "$WORK_DIR"

                DIFF_FILE="/tmp/autofix_diff_$$"
                echo "DIFF_FILE=$DIFF_FILE" >> /tmp/octopus_autofix_workdir

                # Get list of changed TS/TSX files from the PR head vs base
                CHANGED_FILES=$(git diff HEAD~1 --name-only 2>/dev/null | grep -E "\.(ts|tsx)$" || true)

                if [ -z "$CHANGED_FILES" ]; then
                    echo "No TypeScript files changed in this PR."
                    echo "NO_CHANGES=true" >> /tmp/octopus_autofix_workdir
                    exit 0
                fi

                echo "Changed TS files:"
                echo "$CHANGED_FILES"

                # Run ESLint fix on changed files only
                echo "Running eslint --fix..."
                npx eslint --fix $CHANGED_FILES 2>&1 || true

                # Run Prettier on changed files
                echo "Running prettier --write..."
                npx prettier --write $CHANGED_FILES 2>&1 || true

                # Capture diff of auto-applied changes
                git diff --unified=5 > "$DIFF_FILE"
                DIFF_SIZE=$(wc -c < "$DIFF_FILE")

                if [ "$DIFF_SIZE" -lt 5 ]; then
                    echo "No auto-fixable issues found."
                    echo "NO_CHANGES=true" >> /tmp/octopus_autofix_workdir
                else
                    echo "Auto-fix diff generated (${DIFF_SIZE} bytes). Saved to $DIFF_FILE"
                    echo "CHANGED_FILES_COUNT=$(echo $CHANGED_FILES | wc -w)" >> /tmp/octopus_autofix_workdir
                fi
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}

step "post-fix-comment-to-pr" {
    name = "Post Fix Suggestion to PR"

    action {
        action_type = "Octopus.Script"
        notes = "Posts the auto-fix diff as a collapsible GitHub PR comment with copy-paste apply instructions."
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                source /tmp/octopus_autofix_workdir 2>/dev/null || true

                if [ "$NO_CHANGES" = "true" ]; then
                    echo "No fixable issues — skipping PR comment."
                    exit 0
                fi

                if [ ! -f "$DIFF_FILE" ]; then
                    echo "No diff file found — skipping PR comment."
                    exit 0
                fi

                # Truncate diff if > 60KB to stay within GitHub comment limits
                DIFF_CONTENT=$(head -c 60000 "$DIFF_FILE")
                DIFF_LINES=$(wc -l < "$DIFF_FILE")

                COMMENT_BODY=$(python3 -c "
import json, os

diff = open('$DIFF_FILE').read()[:60000]
branch = '#{PRBranch}'
pr_num = '#{PRNumber}'
lines = '$DIFF_LINES'

body = f'''## 🔧 Octopus Auto-Fix Suggestions

> **Branch:** \`{branch}\` | Linter: ESLint + Prettier

ESLint and Prettier identified **automatically fixable** issues. The patch below can be applied directly to your branch.

### How to apply

\`\`\`bash
# From your local checkout on branch {branch}:
git apply <<'PATCH'
{diff}
PATCH
git add -A && git commit -m "fix: apply automated lint/format corrections"
\`\`\`

<details>
<summary>📄 Full patch ({lines} lines)</summary>

\`\`\`diff
{diff}
\`\`\`

</details>

---
*Generated by [Octopus Auto-Fix Runbook](https://octopus.schubert.life) · These are mechanical fixes only — architectural violations require manual remediation.*
'''
print(json.dumps(body))
")

                curl -sf -X POST \
                    "https://api.github.com/repos/theonlygeranium/vinifera/issues/#{PRNumber}/comments" \
                    -H "Authorization: Bearer #{GitHubPAT}" \
                    -H "Accept: application/vnd.github+json" \
                    -H "X-GitHub-Api-Version: 2022-11-28" \
                    -d "{"body": $COMMENT_BODY}" \
                    && echo "Auto-fix comment posted to PR ##{PRNumber}." \
                    || echo "WARNING: Failed to post comment."
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}

step "cleanup" {
    name = "Cleanup"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                source /tmp/octopus_autofix_workdir 2>/dev/null || true
                [ -n "$WORK_DIR" ] && rm -rf "$WORK_DIR"
                [ -n "$DIFF_FILE" ] && rm -f "$DIFF_FILE"
                rm -f /tmp/octopus_autofix_workdir
                echo "Cleanup complete."
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}
