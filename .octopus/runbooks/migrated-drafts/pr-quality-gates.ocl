name = "PR Quality Gates"
cancel_queued_tasks = true
cancel_running_tasks = true
description = "Enforces the 10 architectural, security, and tenancy rules migrated from .greptile/rules.md."

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    quantity_to_keep = 10
    type = "Count"
}

process {
    step "rule-1-no-direct-route-to-database-access" {
        name = "Rule 1: No Direct Route-to-Database Access"

        action {
            action_type = "Octopus.Script"
            notes = "Route handlers in server/routes/ must not create Supabase clients or query the database directly."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = "grep -rn --include=\"*.ts\" -E \"createClient\\s*\\(|from [\"']@supabase/supabase-js[\"']\" server/routes/ 2>/dev/null && echo FAIL && exit 1 || echo PASS"
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "rule-2-no-circular-imports-between-layers" {
        name = "Rule 2: No Circular Imports Between Layers"

        action {
            action_type = "Octopus.Script"
            notes = "server/services/ must not import from server/routes/. Routes must not import from server/integrations/ directly."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = "V1=$(grep -rn --include=\"*.ts\" \"from.*server/routes\" server/services/ 2>/dev/null||true);V2=$(grep -rn --include=\"*.ts\" \"from.*server/integrations\" server/routes/ 2>/dev/null||true);[ -n \"$V1\" ]&&echo \"FAIL services->routes: $V1\"&&exit 1;[ -n \"$V2\" ]&&echo \"FAIL routes->integrations: $V2\"&&exit 1;echo PASS"
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "rule-3-no-provider-secrets-in-source" {
        name = "Rule 3: No Provider Secrets in Source"

        action {
            action_type = "Octopus.Script"
            notes = "TypeScript source files must not contain string literals matching sk_live_, sk_test_, rk_live_, ep_test_, or re_ patterns."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = "VIOLATIONS=$(grep -rn --include=\"*.ts\" -E \"(sk_live_|sk_test_|rk_live_|ep_test_|re_)[A-Za-z0-9_]+\" server/ src/ 2>/dev/null||true);[ -n \"$VIOLATIONS\" ]&&echo \"FAIL: $VIOLATIONS\"&&exit 1;echo PASS"
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "rule-4-zod-validation-on-all-api-inputs" {
        name = "Rule 4: Zod Validation on All API Inputs"

        action {
            action_type = "Octopus.Script"
            notes = "Every Express handler that reads req.body or req.params must validate with a Zod schema before accessing fields."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = "for f in $(grep -rl --include=\"*.ts\" \"req\\.body\\|req\\.params\" server/routes/ 2>/dev/null); do grep -q \"\\.safeParse\\|\\.parse(\" $f||echo \"MISSING ZOD: $f\"; done|grep -q MISSING&&exit 1||echo PASS"
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "rule-5-http-only-cookie-jwts-only" {
        name = "Rule 5: HTTP-Only Cookie JWTs Only"

        action {
            action_type = "Octopus.Script"
            notes = "Web-session auth tokens must be read from req.cookies, never from req.headers.authorization."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = "VIOLATIONS=$(grep -rn --include=\"*.ts\" -E \"req\\.headers(\\.authorization|\\[.authorization.\\])\" server/ 2>/dev/null|grep -v \"mobile\\|native\\|exchange\"||true);[ -n \"$VIOLATIONS\" ]&&echo \"FAIL: $VIOLATIONS\"&&exit 1;echo PASS"
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "rule-6-fail-closed-provider-activation" {
        name = "Rule 6: Fail-Closed Provider Activation"

        action {
            action_type = "Octopus.Script"
            notes = "Code that calls an external provider must confirm the provider activation guard before executing the request."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = "echo \"INFO: Manual review required - check all provider call sites in server/services/ for isActivated() guard.\";echo PASS"
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "rule-7-idempotency-keys-on-mutating-provider-calls" {
        name = "Rule 7: Idempotency Keys on Mutating Provider Calls"

        action {
            action_type = "Octopus.Script"
            notes = "Stripe PaymentIntent, EasyPost label, and Resend send operations must include a stable idempotency key."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = "for f in $(grep -rl --include=\"*.ts\" -E \"paymentIntents\\.create|labels\\.create|emails\\.send\" server/ 2>/dev/null); do grep -q \"idempotencyKey\\|idempotency_key\" $f||echo \"MISSING IDEMPOTENCY KEY: $f\"; done|grep -q MISSING&&exit 1||echo PASS"
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "rule-8-tenant-isolation-on-every-service-function" {
        name = "Rule 8: Tenant Isolation on Every Service Function"

        action {
            action_type = "Octopus.Script"
            notes = "Every service function that queries the database must constrain by brand_id or organization_id."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = "for f in $(grep -rl --include=\"*.ts\" \"\\.from(\" server/services/ 2>/dev/null); do grep -q \"brand_id\\|organization_id\" $f||echo \"MISSING TENANT SCOPE: $f\"; done|grep -q MISSING&&{ echo FAIL; exit 1; }||echo PASS"
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "rule-9-changelog-md-updated-with-every-commit" {
        name = "Rule 9: CHANGELOG.md Updated With Every Commit"

        action {
            action_type = "Octopus.Script"
            notes = "Every non-documentation commit must include an entry under [Unreleased] in CHANGELOG.md."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = "grep -q \"## \\[Unreleased\\]\" CHANGELOG.md||{ echo \"FAIL: missing [Unreleased] section\"; exit 1; };CONTENT=$(awk \"/## \\[Unreleased\\]/{f=1} f && /## \\[/{if(!first){first=1}else{exit}} f{print}\" CHANGELOG.md|grep -v \"^## \"| grep -v \"^$\"|head -3);[ -z \"$CONTENT\" ]&&{ echo \"FAIL: [Unreleased] is empty\"; exit 1; };echo PASS"
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }

    step "rule-10-no-any-type-in-new-server-code" {
        name = "Rule 10: No `any` Type in New Server Code"

        action {
            action_type = "Octopus.Script"
            notes = "New or changed files under server/ must use concrete types or unknown + type guard instead of TypeScript any."
            properties = {
                Octopus.Action.RunOnServer = "true"
                Octopus.Action.Script.ScriptBody = "VIOLATIONS=$(grep -rn --include=\"*.ts\" -E \": any[;,) >]\" server/ 2>/dev/null|grep -v \"\\.d\\.ts\"||true);[ -n \"$VIOLATIONS\" ]&&echo \"FAIL: $VIOLATIONS\"&&exit 1;echo PASS"
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
            }
        }
    }
}