step "pull-and-build" {
    name = "Pull Latest Code and Build"

    action {
        action_type = "Octopus.Script"
        notes = "SSH to schubert-v2, pull the release commit, install dependencies, and build. This step records build evidence; the actual Cloudflare Worker deployment is performed by GitHub Actions workflows (dev-worker-release.yml, production-worker-release.yml)."
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.TargetRoles = "vinifera-app"
            Octopus.Action.Script.ScriptBody = <<-EOT
                set -e
                APP_DIR="/opt/vinifera"
                RELEASE_SHA="#{Octopus.Release.Git.CommitHash}"

                echo "=== Vinifera release #{Octopus.Release.Number} (commit $RELEASE_SHA) ==="
                echo "Octopus serves as release-audit record only."
                echo "Worker deployment is owned by GitHub Actions."

                if [ ! -d "$APP_DIR" ]; then
                    echo "First deploy cloning repository..."
                    sudo mkdir -p "$APP_DIR"
                    sudo chown z121532:z121532 "$APP_DIR"
                    git clone https://#{GitHubPAT}@github.com/theonlygeranium/vinifera.git "$APP_DIR"
                fi

                cd "$APP_DIR"

                echo "Fetching and checking out $RELEASE_SHA..."
                git fetch origin
                git checkout "$RELEASE_SHA"

                echo "Installing dependencies..."
                npm ci --prefer-offline

                echo "Building application..."
                npm run build

                echo "Build complete. Worker deployment handled by GitHub Actions."
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}

step "verify-worker-health" {
    name = "Verify Worker Health Endpoint"

    action {
        action_type = "Octopus.Script"
        notes = "Probes the deployed Cloudflare Worker health endpoint. Replaces the former PM2 restart step (restart-application). Vinifera is deployed as a Cloudflare Worker via GitHub Actions + Wrangler, not as a PM2 Node.js process. Octopus serves as the release-audit and evidence record."
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                set -e
                HEALTH_URL="#{AppHealthUrl}"
                MAX_ATTEMPTS=6
                SLEEP=5

                echo "Probing Worker health at $HEALTH_URL..."
                echo "Note: The Worker is deployed by GitHub Actions, not by this Octopus step."
                echo "This step records evidence that the release health endpoint is reachable."

                for i in $(seq 1 $MAX_ATTEMPTS); do
                    STATUS=$(curl -sf -o /dev/null -w "%{http_code}" "$HEALTH_URL" 2>/dev/null || echo "000")
                    echo "Attempt $i: HTTP $STATUS"
                    if [ "$STATUS" = "200" ] || [ "$STATUS" = "204" ]; then
                        echo "Health check passed."
                        exit 0
                    fi
                    [ $i -lt $MAX_ATTEMPTS ] && sleep $SLEEP
                done

                echo "WARN: Health check did not return 200 after $((MAX_ATTEMPTS * SLEEP))s."
                echo "This may indicate the Worker has not been deployed yet by GitHub Actions."
                echo "The Octopus release record remains valid as an audit trail."
                exit 1
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}

step "notify-on-failure" {
    name = "Notify on Deployment Failure"
    condition = "Failure"

    action {
        action_type = "Octopus.Script"
        notes = "Posts a GitHub issue comment on the triggering commit if the evidence probe fails."
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                COMMIT_SHA="#{Octopus.Release.Git.CommitHash}"
                RELEASE="#{Octopus.Release.Number}"
                ENV="#{Octopus.Environment.Name}"
                LOG_URL="https://octopus.schubert.life/app#/Spaces-1/projects/vinifera/releases/$RELEASE"

                curl -sf -X POST \
                    "https://api.github.com/repos/theonlygeranium/vinifera/commits/$COMMIT_SHA/comments" \
                    -H "Authorization: Bearer #{GitHubPAT}" \
                    -H "Accept: application/vnd.github+json" \
                    -H "X-GitHub-Api-Version: 2022-11-28" \
                    -d "{\"body\": \"Octopus evidence probe failed for release $RELEASE in $ENV. The Worker health endpoint did not respond. View deployment log: $LOG_URL\"}" \
                    && echo "Failure comment posted to commit." \
                    || echo "WARNING: Could not post failure comment."
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
    }
}
