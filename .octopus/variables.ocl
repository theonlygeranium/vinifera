variable "Octopus.Acquire.MaxParallelism" {
    value "10" {
        description = "Max parallel package acquisitions per deployment"
    }
}

variable "Octopus.Action.MaxParallelism" {
    value "10" {
        description = "Max parallel actions per deployment step"
    }
}

variable "NodeEnv" {
    value "production" {}
}

variable "AppHealthUrl" {
    value "https://vinifera-development.jeff-f69.workers.dev/health" {
        description = "Health endpoint for the vinifera-development Cloudflare Worker. Replaced localhost:3000 which assumed a PM2 Node.js server that does not exist."
    }
}

variable "AppName" {
    value "vinifera" {}
}

variable "AppEnv" {
    value "development" {}
}

variable "AppOrigin" {
    value "https://vinifera-dev.edstratumlabs.ai" {}
}

variable "LiveBillingEnabled" {
    value "false" {}
}

variable "AuthEmailEnabled" {
    value "false" {}
}

variable "GoogleOauthEnabled" {
    value "false" {}
}

variable "EasypostLiveLabelsEnabled" {
    value "false" {}
}

variable "ShippingSimulatorEnabled" {
    value "false" {}
}

variable "EmailSimulatorEnabled" {
    value "false" {}
}

variable "ComplianceSimulatorEnabled" {
    value "false" {}
}

variable "SupabaseUrl" {
    value "https://cfrqrllmyquggqjkzifs.supabase.co" {}
}

variable "SupabaseProjectId" {
    value "cfrqrllmyquggqjkzifs" {}
}

variable "ShippingProvider" {
    value "easypost" {}
}

variable "EmailProvider" {
    value "resend" {}
}

variable "ComplianceProvider" {
    value "shipcompliant" {}
}

variable "LiteLLMEndpoint" {
    value "http://172.17.0.1:4000" {}
}

variable "LiteLLMModel" {
    value "writer/palmyra-x5" {}
}

variable "PRBranch" {
    value {
        prompt {
            description = "Exact same-repository pull-request head branch."
            label = "PRBranch"
            required = true
        }
    }
}

variable "PRNumber" {
    value {
        prompt {
            description = "GitHub pull-request number to review."
            label = "PRNumber"
            required = true
        }
    }
}

variable "ExpectedBaseRef" {
    value {
        prompt {
            description = "Expected pull-request base branch."
            label = "ExpectedBaseRef"
            required = true
        }
    }
}

variable "ExpectedBaseSHA" {
    value {
        prompt {
            description = "Exact expected pull-request base commit."
            label = "ExpectedBaseSHA"
            required = true
        }
    }
}

variable "ExpectedHeadSHA" {
    value {
        prompt {
            description = "Exact expected pull-request head commit."
            label = "ExpectedHeadSHA"
            required = true
        }
    }
}
