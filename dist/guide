<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="The Vinifera Investor&#39;s Guide — a plain-language overview of the platform, its technology, phased build plan, and business case for owners, investors, and stakeholders.">
<title>Investor&#39;s Guide — Vinifera Wine Club Platform</title>
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
<style>
/* ── Reset & tokens ─────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --wine:       #6B1E30;
  --wine-dark:  #3D0E1B;
  --wine-mid:   #8A2540;
  --gold:       #C9993A;
  --gold-light: #FDF5E4;
  --cream:      #FAF7F2;
  --stone:      #F0EBE3;
  --border:     #E8E0D6;
  --text:       #1A1208;
  --text-2:     #5C4F3A;
  --text-3:     #9C8C78;
  --white:      #FFFFFF;
  --radius:     10px;
  --radius-lg:  18px;
  --shadow-sm:  0 1px 4px rgba(0,0,0,0.06);
  --shadow-md:  0 4px 20px rgba(0,0,0,0.09);
  --shadow-lg:  0 12px 48px rgba(0,0,0,0.14);
  --prose-max:  72ch;
}
html { font-size: 16px; scroll-behavior: smooth; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
       background: var(--white); color: var(--text); line-height: 1.7;
       -webkit-font-smoothing: antialiased; }
a { color: var(--wine); text-decoration: underline; text-decoration-thickness: 1px;
    text-underline-offset: 3px; }
a:hover { color: var(--wine-dark); }
a:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; border-radius: 3px; }
img { display: block; max-width: 100%; }
button { cursor: pointer; font-family: inherit; border: none; }
button:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; border-radius: 3px; }
h1,h2,h3,h4 { line-height: 1.25; letter-spacing: -0.02em; color: var(--text); }
p { margin-bottom: 1.1em; }
p:last-child { margin-bottom: 0; }

/* ── Nav ──────────────────────────────────────────────────── */
.nav {
  position: sticky; top: 0; z-index: 200;
  background: rgba(255,255,255,0.94); backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--border); padding: 13px 0;
}
.nav-inner { max-width: 1200px; margin: 0 auto; padding: 0 24px;
             display: flex; align-items: center; justify-content: space-between; }
.nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
.nav-logo-mark {
  width: 34px; height: 34px; border-radius: 8px;
  background: var(--wine); display: flex; align-items: center; justify-content: center;
  color: var(--white); font-size: 16px; flex-shrink: 0;
}
.nav-logo-text { font-size: 18px; font-weight: 800; letter-spacing: -0.03em; color: var(--text); }
.nav-logo-sub  { font-size: 10px; font-weight: 600; text-transform: uppercase;
                 letter-spacing: 0.08em; color: var(--text-3); margin-top: -2px; }
.nav-right { display: flex; align-items: center; gap: 12px; }
.btn-nav {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 10px 16px; border-radius: 8px; font-size: 13.5px; font-weight: 600;
  text-decoration: none; min-height: 44px;
}
.btn-nav-ghost { color: var(--text); border: 1px solid var(--border); background: transparent;
                 transition: border-color .15s, color .15s; }
.btn-nav-ghost:hover { border-color: var(--wine); color: var(--wine); }
.btn-nav-wine  { background: var(--wine); color: var(--white);
                 box-shadow: 0 1px 8px rgba(107,30,48,.22); transition: background .15s; }
.btn-nav-wine:hover { background: var(--wine-dark); }
.hamburger {
  display: none; background: transparent; border: 1px solid var(--border);
  border-radius: 8px; padding: 10px; color: var(--text); align-items: center; justify-content: center;
  min-width: 44px; min-height: 44px;
}
@media(max-width:700px){
  .nav-right .btn-nav-ghost { display: none; }
  .hamburger { display: flex; }
}

/* Mobile nav drawer */
.mobile-drawer {
  display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 300;
}
.mobile-drawer.open { display: block; }
.drawer-overlay { position: absolute; inset: 0; background: rgba(0,0,0,.45); }
.drawer-panel {
  position: absolute; top: 0; right: 0; bottom: 0; width: min(80vw, 320px);
  background: var(--white); padding: 24px 20px; overflow-y: auto;
  display: flex; flex-direction: column; gap: 8px;
}
.drawer-close {
  align-self: flex-end; background: transparent; border: 1px solid var(--border);
  border-radius: 8px; padding: 8px; color: var(--text); cursor: pointer;
  margin-bottom: 8px;
}
.drawer-link {
  display: block; padding: 12px 14px; border-radius: 8px; font-size: 15px;
  font-weight: 500; color: var(--text); text-decoration: none; transition: background .15s;
}
.drawer-link:hover { background: var(--stone); }
.drawer-link.active { background: var(--wine); color: var(--white); font-weight: 600; }
.drawer-divider { height: 1px; background: var(--border); margin: 8px 0; }

/* ── Hero banner ───────────────────────────────────────────── */
.hero {
  background: linear-gradient(155deg, #0F0208 0%, #2A0A14 45%, #6B1E30 78%, #C9993A 100%);
  padding: 72px 24px 64px; text-align: center; position: relative; overflow: hidden;
}
.hero::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(201,153,58,.13) 0%, transparent 70%);
  pointer-events: none;
}
.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(201,153,58,.18); border: 1px solid rgba(201,153,58,.35);
  color: var(--gold); padding: 6px 14px; border-radius: 100px;
  font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
  margin-bottom: 20px;
}
.hero h1 {
  font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 900; color: var(--white);
  letter-spacing: -.03em; margin-bottom: 14px; position: relative;
}
.hero h1 span { color: var(--gold); }
.hero-sub {
  font-size: clamp(.95rem, 2vw, 1.1rem); color: rgba(255,255,255,.75);
  max-width: 54ch; margin: 0 auto 28px; position: relative;
}
.hero-meta {
  display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 8px 16px;
  background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.12);
  border-radius: var(--radius); padding: 12px 20px;
  font-size: 12.5px; color: rgba(255,255,255,.65); position: relative;
}
.hero-meta strong { color: rgba(255,255,255,.9); }
.hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 28px; position: relative; }
.btn-primary {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--wine); color: var(--white);
  padding: 13px 26px; border-radius: var(--radius); font-size: 15px; font-weight: 700;
  letter-spacing: -.01em; transition: background .18s, transform .12s;
  box-shadow: 0 2px 12px rgba(107,30,48,.35); text-decoration: none;
}
.btn-primary:hover { background: var(--wine-dark); transform: translateY(-1px); color: var(--white); }
.btn-gold {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--gold); color: var(--wine-dark);
  padding: 13px 26px; border-radius: var(--radius); font-size: 15px; font-weight: 700;
  transition: filter .18s, transform .12s; box-shadow: 0 2px 16px rgba(201,153,58,.35);
  text-decoration: none;
}
.btn-gold:hover { filter: brightness(1.08); transform: translateY(-1px); color: var(--wine-dark); }

/* ── Progress bar ──────────────────────────────────────────── */
#read-progress {
  position: fixed; top: 0; left: 0; height: 3px;
  background: linear-gradient(90deg, var(--wine), var(--gold));
  z-index: 500; transition: width .1s linear; width: 0%;
}

/* ── Layout ────────────────────────────────────────────────── */
.layout {
  max-width: 1200px; margin: 0 auto; padding: 40px 24px 80px;
  display: grid; grid-template-columns: 260px 1fr; gap: 48px; align-items: start;
}
@media(max-width:900px){ .layout { grid-template-columns: 1fr; } }

/* ── Sidebar TOC ───────────────────────────────────────────── */
.toc {
  position: sticky; top: 80px; max-height: calc(100vh - 100px);
  overflow-y: auto; padding-right: 8px;
}
.toc-label {
  font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em;
  color: var(--text-3); margin-bottom: 12px;
}
.toc-list { list-style: none; display: flex; flex-direction: column; gap: 2px; }
.toc-item a {
  display: flex; align-items: center; padding: 7px 12px; min-height: 44px; border-radius: 7px;
  font-size: 13.5px; color: var(--text-2); text-decoration: none; font-weight: 500;
  border-left: 2px solid transparent; transition: background .15s, color .15s, border-color .15s;
}
.toc-item a:hover { background: var(--stone); color: var(--wine); }
.toc-item a.active { background: var(--gold-light); color: var(--wine); font-weight: 700;
                     border-left-color: var(--wine); }
.toc-divider { height: 1px; background: var(--border); margin: 10px 0; }
.toc-cta {
  margin-top: 20px; background: var(--wine); color: var(--white);
  padding: 12px 16px; border-radius: var(--radius); font-size: 13px; font-weight: 700;
  text-align: center; display: block; text-decoration: none; transition: background .15s;
}
.toc-cta:hover { background: var(--wine-dark); color: var(--white); }
@media(max-width:900px){ .toc { display: none; } }

/* Mobile sticky TOC pill */
.mobile-toc-bar {
  display: none; position: sticky; top: 61px; z-index: 150;
  background: var(--white); border-bottom: 1px solid var(--border);
  padding: 10px 20px; overflow-x: auto; gap: 8px; white-space: nowrap;
  scrollbar-width: none;
}
.mobile-toc-bar::-webkit-scrollbar { display: none; }
@media(max-width:900px){ .mobile-toc-bar { display: flex; } }
.toc-pill {
  display: inline-flex; align-items: center; padding: 0 14px; border-radius: 100px;
  font-size: 12.5px; font-weight: 600; color: var(--text-2); background: var(--stone);
  text-decoration: none; transition: background .15s, color .15s; flex-shrink: 0;
  min-height: 44px;
}
.toc-pill:hover, .toc-pill.active { background: var(--wine); color: var(--white); }

/* ── Article prose ─────────────────────────────────────────── */
.article { min-width: 0; }
.part {
  padding-top: 16px; margin-bottom: 64px;
  border-top: 1px solid var(--border);
}
.part:first-child { border-top: none; padding-top: 0; }
.part-eyebrow {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em;
  color: var(--wine); margin-bottom: 12px;
}
.part h2 {
  font-size: clamp(1.45rem, 3vw, 1.9rem); font-weight: 800; margin-bottom: 20px;
  max-width: var(--prose-max);
}
.part h3 {
  font-size: 1.1rem; font-weight: 700; margin: 28px 0 10px; color: var(--wine-mid);
}
.part p { font-size: 1rem; color: var(--text-2); max-width: var(--prose-max); }
.part p strong { color: var(--text); }

/* ── Callout cards ─────────────────────────────────────────── */
.callout {
  background: var(--gold-light); border: 1px solid rgba(201,153,58,.25);
  border-left: 4px solid var(--gold); border-radius: var(--radius);
  padding: 18px 20px; margin: 24px 0; max-width: var(--prose-max);
}
.callout p { color: var(--text); font-size: .95rem; margin: 0; }
.callout-wine {
  background: #FDF1F3; border-color: rgba(107,30,48,.15);
  border-left-color: var(--wine);
}
.callout-wine p { color: var(--wine-dark); }

/* ── Feature grid ──────────────────────────────────────────── */
.feature-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 16px; margin: 24px 0;
}
.feature-card {
  background: var(--cream); border: 1px solid var(--border); border-radius: var(--radius);
  padding: 18px 20px; transition: box-shadow .18s, transform .15s;
}
.feature-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
.feature-card-icon {
  width: 38px; height: 38px; border-radius: 9px; background: var(--wine);
  display: flex; align-items: center; justify-content: center;
  color: var(--white); margin-bottom: 12px; flex-shrink: 0;
}
.feature-card h4 { font-size: .95rem; font-weight: 700; margin-bottom: 6px; color: var(--text); }
.feature-card p  { font-size: .875rem; color: var(--text-2); margin: 0; }

/* ── Tech stack cards ──────────────────────────────────────── */
.tech-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 14px; margin: 24px 0;
}
.tech-card {
  border: 1px solid var(--border); border-radius: var(--radius); padding: 16px 18px;
  background: var(--white);
}
.tech-card-label {
  font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em;
  color: var(--text-3); margin-bottom: 6px;
}
.tech-card h4 { font-size: .9rem; font-weight: 700; color: var(--wine); margin-bottom: 4px; }
.tech-card p  { font-size: .84rem; color: var(--text-2); margin: 0; }

/* ── Phase timeline ────────────────────────────────────────── */
.timeline { margin: 28px 0; display: flex; flex-direction: column; gap: 0; }
.phase {
  display: grid; grid-template-columns: 40px 1fr; gap: 0 20px;
  position: relative;
}
.phase-line {
  display: flex; flex-direction: column; align-items: center;
}
.phase-dot {
  width: 40px; height: 40px; border-radius: 50%; background: var(--wine);
  display: flex; align-items: center; justify-content: center;
  color: var(--white); font-size: 14px; font-weight: 800; flex-shrink: 0; z-index: 1;
}
.phase-connector {
  width: 2px; background: var(--border); flex: 1; min-height: 24px; margin: 4px 0;
}
.phase:last-child .phase-connector { display: none; }
.phase-content { padding-bottom: 32px; }
.phase-tag {
  display: inline-block; background: var(--stone); color: var(--text-3);
  font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em;
  padding: 3px 10px; border-radius: 100px; margin-bottom: 8px;
}
.phase-content h3 { font-size: 1rem; font-weight: 700; margin-bottom: 8px; color: var(--text); }
.phase-content p  { font-size: .9rem; color: var(--text-2); max-width: 60ch; margin: 0; }
.phase-current .phase-dot { background: var(--gold); }
.phase-current .phase-tag { background: #FEF3D1; color: #7A5A10; }

/* ── Pricing table ─────────────────────────────────────────── */
.pricing-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(210px,1fr));
  gap: 16px; margin: 24px 0;
}
.pricing-card {
  border: 1.5px solid var(--border); border-radius: var(--radius-lg);
  padding: 22px 20px; background: var(--white); transition: box-shadow .18s;
}
.pricing-card:hover { box-shadow: var(--shadow-md); }
.pricing-card.featured { border-color: var(--wine); background: #FDF1F3; }
.pricing-tier {
  font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em;
  color: var(--text-3); margin-bottom: 6px;
}
.pricing-card.featured .pricing-tier { color: var(--wine); }
.pricing-price { font-size: 1.8rem; font-weight: 900; color: var(--text); letter-spacing: -.03em; }
.pricing-period { font-size: .85rem; color: var(--text-3); margin-left: 2px; }
.pricing-desc { font-size: .85rem; color: var(--text-2); margin: 10px 0 0; }

/* ── Stats strip ───────────────────────────────────────────── */
.stats-strip {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(160px,1fr));
  gap: 1px; background: var(--border); border: 1px solid var(--border);
  border-radius: var(--radius-lg); overflow: hidden; margin: 28px 0;
}
.stat-cell {
  background: var(--white); padding: 22px 20px; text-align: center;
}
.stat-value { font-size: 1.8rem; font-weight: 900; color: var(--wine); letter-spacing: -.03em; }
.stat-label { font-size: .8rem; color: var(--text-3); font-weight: 500; margin-top: 4px; }

/* ── Attribution ───────────────────────────────────────────── */
.attribution {
  background: linear-gradient(135deg, var(--wine-dark) 0%, var(--wine) 100%);
  border-radius: var(--radius-lg); padding: 36px 32px; color: var(--white);
  margin: 32px 0;
}
.attribution h3 { font-size: 1.15rem; font-weight: 800; color: var(--white); margin-bottom: 10px; }
.attribution p  { font-size: .92rem; color: rgba(255,255,255,.8); max-width: 60ch; margin-bottom: 14px; }
.attribution p:last-child { margin: 0; }
.attribution a  { color: var(--gold); text-decoration: underline; display: inline-flex; align-items: center; min-height: 44px; }
.attribution-meta {
  display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 20px; padding-top: 20px;
  border-top: 1px solid rgba(255,255,255,.15); font-size: .85rem;
}
.attribution-meta span { color: rgba(255,255,255,.65); }
.attribution-meta strong { color: var(--white); }

/* ── Footer ────────────────────────────────────────────────── */
.footer {
  background: var(--wine-dark); color: rgba(255,255,255,.6);
  padding: 32px 24px; text-align: center; font-size: .85rem;
}
.footer a { color: var(--gold); text-decoration: underline; }
.footer-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 8px; margin-bottom: 12px; }
.footer-links a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 10px; border-radius: 6px; }

/* ── Skip link ─────────────────────────────────────────────── */
.skip-link {
  position: absolute; top: -100px; left: 16px; z-index: 9999;
  background: var(--wine); color: var(--white); padding: 10px 18px;
  border-radius: 8px; font-weight: 700; text-decoration: none;
  transition: top .15s;
}
.skip-link:focus { top: 16px; }

/* ── Reduced motion ────────────────────────────────────────── */
@media(prefers-reduced-motion:reduce){
  *, *::before, *::after { transition: none !important; animation: none !important; }
  html { scroll-behavior: auto; }
}
</style>
</head>
