# .env.example
# Non-secret environment variable template.
# Copy this to .env and fill in real values.
# NEVER commit .env to source control.
# NEVER put real secret values in this file.

# ── Application ──────────────────────────────────────────────────────────
# APP_NAME=vinifera
# APP_ENV=development                 # development, test, staging, or production

# ── Cloudflare Pages ──────────────────────────────────────────────────────
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# ── GitHub (for CI/CD secrets) ───────────────────────────────────────────
# GH_TOKEN=your-github-personal-access-token
# Repository variables, not runtime secrets:
# STAGING_SUPABASE_MIGRATION_ENABLED=false
# STAGING_CLOUDFLARE_DEPLOY_ENABLED=false
# VITE_MOBILE_API_ORIGIN=             # Isolated vinifera-staging.*.workers.dev only
# Mutating CI jobs use STAGING_* environment secrets and never fall back to
# generic repository credentials. See docs/runbooks/hosted-environment-provisioning.md.

# ── Supabase (PostgreSQL + Auth) ─────────────────────────────────────────
# All Supabase credentials are stored as encrypted GitHub repository secrets.
# Codex reads them from the repo environment — do NOT hardcode values in source files.
# SUPABASE_URL=                      # Project URL (e.g. https://xxxxxxxx.supabase.co)
# SUPABASE_ANON_KEY=                 # Public, client-safe
# SUPABASE_SERVICE_ROLE_KEY=         # Secret, server-only — bypasses RLS, never client-side
# SUPABASE_PUBLISHABLE_KEY=          # New-format publishable key (sb_publishable_*)
# SUPABASE_SECRET_KEY=               # New-format secret key (sb_secret_*)
# SUPABASE_ACCESS_TOKEN=              # CI migration access only (sbp_*); never exposed to runtime
# SUPABASE_PROJECT_ID=                # Project reference used by Supabase CLI
# SUPABASE_DB_PASSWORD=               # CI migration access only
# SUPABASE_GOOGLE_CLIENT_ID=          # Configure in Supabase Auth provider settings
# SUPABASE_GOOGLE_CLIENT_SECRET=      # Configure in Supabase Auth provider settings
# CF_ACCESS_CLIENT_ID=                # Service-token ID when Supabase ingress is Access-protected
# CF_ACCESS_CLIENT_SECRET=            # Matching service-token secret for GoTrue and PostgREST

# ── Stripe (Payments — test mode until owner-approved Phase 5 cutover) ────
# Stripe credentials are stored as encrypted GitHub repository secrets.
# STRIPE_SECRET_KEY=                 # sk_test_* (server-only)
# STRIPE_WEBHOOK_SECRET=             # whsec_* (register endpoint in Stripe dashboard)
# STRIPE_PRICE_VINE=                  # Recurring $149/month test Price ID
# STRIPE_PRICE_CELLAR=                # Recurring $349/month test Price ID
# STRIPE_PRICE_ESTATE=                # Recurring $749/month test Price ID
# STRIPE_PRICE_RESERVE=               # Recurring $1,500/month test Price ID
# LIVE_BILLING_ENABLED=false          # Separate human-approved gate

# ── Application security ─────────────────────────────────────────────────
# APP_ORIGIN=                        # Canonical origin (no trailing slash)
# ALLOWED_ORIGINS=                   # Comma-separated browser origins; never use *
# AUTH_EMAIL_ENABLED=false           # Set true after Supabase SMTP is live-tested
# GOOGLE_OAUTH_ENABLED=false         # Set true after Supabase Google OAuth is live-tested
# Both values: independent, server-only, and 32+ UTF-8 bytes.
# Reject surrounding whitespace; the values must differ.
# RATE_LIMIT_PEPPER=                 # One-way IP hashing
# MEMBER_BRAND_CONTEXT_SECRET=       # Different value; signs member brand context

# ── Phase 2: Carrier API (shipping labels) ──────────────────────────────
# SHIPPING_PROVIDER=easypost         # First production adapter
# EASYPOST_API_KEY=EZTK...           # Server-only EasyPost test key
# EASYPOST_LIVE_LABELS_ENABLED=false # Independent production authority for EZAK live keys
# SHIPPING_SIMULATOR_ENABLED=false   # Test/non-production only; rejected in production

# ── Phase 3: Resend (email automation) ─────────────────────────────────
# EMAIL_PROVIDER=resend             # Production adapter; use simulated only in explicit tests
# EMAIL_SIMULATOR_ENABLED=false     # Test/non-production only; rejected in production
# RESEND_API_KEY=re_*               # Server-only Resend API key
# RESEND_FROM=Winery <club@example.com> # Legacy/default sender; per-brand sender must also verify
# RESEND_SENDING_DOMAIN=example.com # Default domain; does not activate a brand sender identity
# RESEND_DOMAIN_VERIFIED=false      # Set true only after Resend reports the default domain verified
# RESEND_WEBHOOK_SECRET=whsec_*     # Signing secret for /api/webhooks/resend
# UNSUBSCRIBE_SIGNING_SECRET=       # High-entropy server-only HMAC secret

# ── Phase 4: ShipCompliant (compliance) ─────────────────────────────────
# COMPLIANCE_PROVIDER=shipcompliant       # Production adapter
# COMPLIANCE_SIMULATOR_ENABLED=false      # Test-only; rejected in production
# SHIPCOMPLIANT_BASE_URL=                 # Vendor-approved HTTPS sandbox or production origin
# SHIPCOMPLIANT_ENDPOINT_MODE=sandbox     # sandbox outside production; production is policy-gated
# SHIPCOMPLIANT_TOKEN_PATH=               # Required vendor-approved, versioned OAuth token path
# SHIPCOMPLIANT_CHECK_PATH=               # Versioned shipment compliance-check path
# SHIPCOMPLIANT_CONTRACT_VERSION=         # Contract identifier validated during onboarding
# SHIPCOMPLIANT_API_KEY=                  # Server-only OAuth client identifier
# SHIPCOMPLIANT_API_SECRET=               # Server-only OAuth client secret
# SHIPCOMPLIANT_ACCOUNT_ID=                # Winery/provider account identifier
# SHIPCOMPLIANT_LICENSE_ID=                # Winery license used for compliance decisions
# ML_PLATFORM_ACTOR_USER_ID=               # Active platform super-admin UUID for audited ML automation

# ── Phase 5: Integration credential vault ──────────────────────────────
# Winery-scoped Klaviyo, Avalara, and Meta credentials are entered through the
# staff integration UI and encrypted before persistence. Do not place them in
# shared runtime environment variables.
# INTEGRATION_CREDENTIAL_ACTIVE_KEY_VERSION=1
# INTEGRATION_CREDENTIAL_ENCRYPTION_KEYS=    # JSON object: key version → 32-byte base64 key
# Optional external references are restricted to env://VINIFERA_INTEGRATION_SECRET_<NAME>.
# The referenced Worker binding contains one provider credential JSON object.
# VINIFERA_INTEGRATION_SECRET_META_REHEARSAL= # Example binding name only; never commit a value

# ── Phase 5: QuickBooks application OAuth ──────────────────────────────
# QUICKBOOKS_CLIENT_ID=                     # Intuit application client ID
# QUICKBOOKS_CLIENT_SECRET=                 # Intuit application client secret
# QUICKBOOKS_ENVIRONMENT=sandbox            # sandbox until activation validation passes
# QUICKBOOKS_REDIRECT_URI=                  # Exact HTTPS callback registered with Intuit
# QUICKBOOKS_STATE_SIGNING_SECRET=          # High-entropy, server-only HMAC secret

# ── Phase 5: White-label custom domains ────────────────────────────────
# CLOUDFLARE_CUSTOM_HOSTNAME_API_TOKEN=     # Scoped Custom Hostnames API token
# CLOUDFLARE_CUSTOM_HOSTNAME_ORIGIN=        # Origin hostname only; no scheme or path
# CLOUDFLARE_ZONE_ID=                       # SaaS fallback-origin zone
# MEMBER_BRAND_CONTEXT_SECRET is defined under Application security and signs
# canonical-host member brand context. It must never equal RATE_LIMIT_PEPPER.

# ── Phase 5: Mobile auth and store policy ──────────────────────────────
# MOBILE_BUILD_PROFILE=compile-only          # compile-only, staging-runtime, or production-authorized
# MOBILE_PRODUCTION_ORIGIN_AUTHORIZED=false  # true only inside protected signed-release workflow
# VITE_MOBILE_API_ORIGIN=https://unconfigured.invalid
# MOBILE_AUTH_EMAIL_TEMPLATE_ENABLED=false  # Enable only after Supabase token_hash template is verified
# MOBILE_AUTH_STATE_SIGNING_SECRET=         # High-entropy, server-only HMAC secret
# MOBILE_IOS_BUNDLE_ID=ai.edstratumlabs.vinifera
# MOBILE_APPLE_TEAM_ID=                     # Apple Developer team ID
# MOBILE_IOS_MINIMUM_VERSION=0.5.0
# MOBILE_IOS_LATEST_VERSION=0.5.0
# MOBILE_IOS_STORE_URL=                     # App Store/TestFlight destination when available
# MOBILE_ANDROID_PACKAGE_NAME=ai.edstratumlabs.vinifera
# MOBILE_ANDROID_SIGNING_CERT_SHA256=       # Colon-delimited release signing fingerprint
# MOBILE_ANDROID_MINIMUM_VERSION=0.5.0
# MOBILE_ANDROID_LATEST_VERSION=0.5.0
# MOBILE_ANDROID_STORE_URL=                 # Play Store internal/production destination

# ── Phase 5: Native push delivery ──────────────────────────────────────
# APNS_BUNDLE_ID=ai.edstratumlabs.vinifera
# APNS_ENVIRONMENT=sandbox                  # sandbox for development builds; production only after release signing
# APNS_KEY_ID=
# APNS_PRIVATE_KEY=                         # APNs .p8 contents; preserve newlines
# APNS_TEAM_ID=
# FCM_CLIENT_EMAIL=                         # Firebase service-account client email
# FCM_PRIVATE_KEY=                          # Firebase service-account private key
# FCM_PROJECT_ID=                           # Must match reviewed provider-target SHA-256 policy

# ── Protected signed mobile release (GitHub environment only) ─────────
# MOBILE_ANDROID_KEYSTORE_BASE64=
# MOBILE_ANDROID_KEYSTORE_PASSWORD=
# MOBILE_ANDROID_KEY_ALIAS=
# MOBILE_ANDROID_KEY_PASSWORD=
# MOBILE_GOOGLE_SERVICES_JSON_BASE64=
# GOOGLE_PLAY_RELEASE_SERVICE_ACCOUNT_JSON_BASE64=
# MOBILE_IOS_DISTRIBUTION_CERTIFICATE_BASE64=
# MOBILE_IOS_DISTRIBUTION_CERTIFICATE_PASSWORD=
# MOBILE_IOS_APP_STORE_PROFILE_BASE64=
# APP_STORE_CONNECT_API_KEY_ID=
# APP_STORE_CONNECT_ISSUER_ID=
# APP_STORE_CONNECT_API_PRIVATE_KEY_BASE64=
# These are release-runner inputs, not Worker bindings. See
# docs/runbooks/mobile-store-release.md.

# ── Protected production Worker control (GitHub environment only) ─────
# PRODUCTION_CLOUDFLARE_ACCOUNT_ID=
# PRODUCTION_CLOUDFLARE_API_TOKEN=
# PRODUCTION_CLOUDFLARE_ZONE_ID=
# PRODUCTION_CUSTOM_HOSTNAME=vinifera.edstratumlabs.ai
# PRODUCTION_PAGES_PROJECT_NAME=vinifera
# PRODUCTION_WORKER_ORIGIN=
# Runtime bindings use PRODUCTION_<name> environment secrets and are assembled
# ephemerally by the controlled workflow. Stripe remains test-mode.

# ── Protected credential rotation (GitHub production environment only) ─
# PRODUCTION_INTEGRATION_CREDENTIAL_ACTIVE_KEY_VERSION=
# PRODUCTION_INTEGRATION_CREDENTIAL_ENCRYPTION_KEYS= # Include source and target versions during rotation
# PRODUCTION_SUPABASE_URL=
# PRODUCTION_SUPABASE_SERVICE_ROLE_KEY=
# The rotation policy is disabled and target/key-transition hash arrays are empty
# until separately reviewed. These are workflow bindings, not browser variables.

# ── Protected Stripe live-billing control (GitHub production only) ─────
# PRODUCTION_LIVE_BILLING_AUTHORITY=         # Independent exact authority phrase
# PRODUCTION_STRIPE_TEST_SECRET_KEY=
# PRODUCTION_STRIPE_TEST_WEBHOOK_SECRET=
# PRODUCTION_STRIPE_PRICE_VINE=
# PRODUCTION_STRIPE_PRICE_CELLAR=
# PRODUCTION_STRIPE_PRICE_ESTATE=
# PRODUCTION_STRIPE_PRICE_RESERVE=
# PRODUCTION_STRIPE_LIVE_SECRET_KEY=
# PRODUCTION_STRIPE_LIVE_WEBHOOK_SECRET=
# PRODUCTION_STRIPE_LIVE_PRICE_VINE=
# PRODUCTION_STRIPE_LIVE_PRICE_CELLAR=
# PRODUCTION_STRIPE_LIVE_PRICE_ESTATE=
# PRODUCTION_STRIPE_LIVE_PRICE_RESERVE=
# Live billing stays disabled until config/stripe-live-billing-policy.json has
# independently reviewed account, webhook, Worker, and Price target hashes.

# ── Protected Gate 19 live financial proof (GitHub production only) ──
# PRODUCTION_STRIPE_LIVE_PROOF_BRAND_ID=
# PRODUCTION_STRIPE_LIVE_PROOF_CUSTOMER_ID=
# PRODUCTION_STRIPE_LIVE_PROOF_HANDOFF_CERTIFICATE_BASE64=
# PRODUCTION_STRIPE_LIVE_PROOF_PRICE_ID=
# PRODUCTION_STRIPE_LIVE_PROOF_PLAN=
# PRODUCTION_STRIPE_LIVE_PROOF_MAX_AMOUNT_CENTS=
# PRODUCTION_STRIPE_LIVE_PROOF_ORGANIZATION_ID=
# Reuses the protected live Stripe, webhook, Supabase, and Worker-origin values
# above. The separate proof policy remains disabled with empty exact-target
# hashes until the owner reviews one customer, Price, plan, amount, and origin.

# ── Tailscale (Schubert fallback deploy) ─────────────────────────────────
# TS_OAUTH_CLIENT_ID=your-tailscale-client-id
# TS_OAUTH_SECRET=your-tailscale-client-secret

# ── Schubert Nexus (fallback deploy target) ──────────────────────────────
# SCHUBERT_SSH_KEY=path-to-ssh-private-key

# ── Subdomain Pages deployments (vinifera-dev / vinifera-live) ───────────────────
# Two separate Cloudflare Pages projects serve the React application on subdomains
# while the root domain (vinifera.edstratumlabs.ai) continues serving the static
# marketing site and /app prototype.
#
# Project: vinifera-dev   | branch: dev  | https://vinifera-dev.edstratumlabs.ai
# Project: vinifera-live  | branch: main | https://vinifera-live.edstratumlabs.ai
#
# Set these in Cloudflare Pages → [project] → Settings → Environment Variables.
# CF_PAGES is injected automatically by Cloudflare; set it explicitly only for
# local testing of the Pages build path.
#
# VITE_SUPABASE_URL=        # dev: https://cfrqrllmyquggqjkzifs.supabase.co
#                           # live: https://lefbjbulzmtgidjbemzb.supabase.co
# VITE_SUPABASE_ANON_KEY=   # Project anon key (safe to expose in browser bundle)
# VITE_APP_ENV=             # development | production
# NODE_VERSION=22
# CF_PAGES=1                # Triggers build:pages path in scripts/build.mjs;
#                           # copies /app prototype into dist/ output
#
# Build command:  npm run build:pages
# Output dir:     dist
# Root dir:       (repository root)
#
# service_role key and JWT secrets (RATE_LIMIT_PEPPER, MEMBER_BRAND_CONTEXT_SECRET)
# go into Cloudflare Workers secrets — never into Pages env vars or the browser bundle.
