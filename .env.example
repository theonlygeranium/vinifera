# .env.example
# Non-secret environment variable template.
# Copy this to .env and fill in real values.
# NEVER commit .env to source control.
# NEVER put real secret values in this file.

# ── Application ──────────────────────────────────────────────────────────
# APP_NAME=vinifera
# APP_ENV=production

# ── Cloudflare Pages ──────────────────────────────────────────────────────
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_WORKERS_DEPLOY_ENABLED=false  # Set true after token permission is verified

# ── GitHub (for CI/CD secrets) ───────────────────────────────────────────
# GH_TOKEN=your-github-personal-access-token

# ── Supabase (PostgreSQL + Auth) ─────────────────────────────────────────
# All Supabase credentials are stored as encrypted GitHub repository secrets.
# Codex reads them from the repo environment — do NOT hardcode values in source files.
# SUPABASE_URL=                      # Project URL (e.g. https://xxxxxxxx.supabase.co)
# SUPABASE_ANON_KEY=                 # Public, client-safe
# SUPABASE_SERVICE_ROLE_KEY=         # Secret, server-only — bypasses RLS, never client-side
# SUPABASE_PUBLISHABLE_KEY=          # New-format publishable key (sb_publishable_*)
# SUPABASE_SECRET_KEY=               # New-format secret key (sb_secret_*)
# SUPABASE_ACCESS_TOKEN=              # CI migration access only (sbp_*); never exposed to runtime
# SUPABASE_PROJECT_ID=                # Project reference used by Supabase CLI
# SUPABASE_DB_PASSWORD=               # CI migration access only
# SUPABASE_GOOGLE_CLIENT_ID=          # Configure in Supabase Auth provider settings
# SUPABASE_GOOGLE_CLIENT_SECRET=      # Configure in Supabase Auth provider settings

# ── Stripe (Payments — test mode for Phases 1–4) ─────────────────────────
# Stripe credentials are stored as encrypted GitHub repository secrets.
# STRIPE_PUBLISHABLE_KEY=            # pk_test_* (client-safe)
# STRIPE_SECRET_KEY=                 # sk_test_* (server-only)
# STRIPE_WEBHOOK_SECRET=             # whsec_* (register endpoint in Stripe dashboard)
# STRIPE_PRICE_VINE=                  # Recurring $149/month test Price ID
# STRIPE_PRICE_CELLAR=                # Recurring $349/month test Price ID
# STRIPE_PRICE_ESTATE=                # Recurring $749/month test Price ID
# STRIPE_PRICE_RESERVE=               # Recurring $1,500/month test Price ID

# ── Application security ─────────────────────────────────────────────────
# APP_ORIGIN=                        # Canonical origin (no trailing slash)
# ALLOWED_ORIGINS=                   # Comma-separated browser origins; never use *
# AUTH_EMAIL_ENABLED=false           # Set true after Supabase SMTP is live-tested
# GOOGLE_OAUTH_ENABLED=false         # Set true after Supabase Google OAuth is live-tested
# RATE_LIMIT_PEPPER=                 # Random server-only value for one-way IP hashing

# ── Phase 2: Carrier API (shipping labels) ──────────────────────────────
# SHIPPING_PROVIDER=easypost         # First production adapter
# EASYPOST_API_KEY=EZTK...           # Server-only EasyPost test key
# SHIPPING_SIMULATOR_ENABLED=false   # Test/non-production only; rejected in production

# ── Phase 3: Resend (email automation) ─────────────────────────────────
# EMAIL_PROVIDER=resend             # Production adapter; use simulated only in explicit tests
# EMAIL_SIMULATOR_ENABLED=false     # Test/non-production only; rejected in production
# RESEND_API_KEY=re_*               # Server-only Resend API key
# RESEND_FROM=Winery <club@example.com> # Must use the verified sending domain
# RESEND_SENDING_DOMAIN=example.com # Winery domain verified in Resend
# RESEND_DOMAIN_VERIFIED=false      # Set true only after Resend reports verified
# RESEND_WEBHOOK_SECRET=whsec_*     # Signing secret for /api/webhooks/resend
# UNSUBSCRIBE_SIGNING_SECRET=       # High-entropy server-only HMAC secret

# ── Phase 4: ShipCompliant (compliance) ─────────────────────────────────
# COMPLIANCE_PROVIDER=shipcompliant       # Production adapter
# COMPLIANCE_SIMULATOR_ENABLED=false      # Test-only; rejected in production
# SHIPCOMPLIANT_BASE_URL=                 # Vendor-approved HTTPS sandbox or production origin
# SHIPCOMPLIANT_TOKEN_PATH=/oauth/token   # Confirm against the contracted API version
# SHIPCOMPLIANT_CHECK_PATH=               # Versioned shipment compliance-check path
# SHIPCOMPLIANT_CONTRACT_VERSION=         # Contract identifier validated during onboarding
# SHIPCOMPLIANT_API_KEY=                  # Server-only OAuth client identifier
# SHIPCOMPLIANT_API_SECRET=               # Server-only OAuth client secret
# SHIPCOMPLIANT_ACCOUNT_ID=                # Winery/provider account identifier
# SHIPCOMPLIANT_LICENSE_ID=                # Winery license used for compliance decisions

# ── Phase 5: Third-party integrations ──────────────────────────────────
# KLAVIYO_API_KEY=your-klaviyo-api-key
# QUICKBOOKS_CLIENT_ID=your-quickbooks-client-id
# QUICKBOOKS_CLIENT_SECRET=your-quickbooks-client-secret
# AVALARA_API_KEY=your-avalara-api-key
# META_APP_ID=your-meta-app-id
# META_APP_SECRET=your-meta-app-secret

# ── Tailscale (Schubert fallback deploy) ─────────────────────────────────
# TS_OAUTH_CLIENT_ID=your-tailscale-client-id
# TS_OAUTH_SECRET=your-tailscale-client-secret

# ── Schubert Nexus (fallback deploy target) ──────────────────────────────
# SCHUBERT_SSH_KEY=path-to-ssh-private-key
