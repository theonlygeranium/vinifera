# Sentry
# Use a project DSN only in the untracked .dev.vars file.
SENTRY_DSN=

# Local Worker environment
APP_ENV=development
APP_ORIGIN=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8787

# Generate these separately. Each must contain 32+ UTF-8 bytes, have no
# surrounding whitespace, and differ. Keep real values only in the ignored
# .dev.vars file.
RATE_LIMIT_PEPPER=
MEMBER_BRAND_CONTEXT_SECRET=
